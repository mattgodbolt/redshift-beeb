\ ***************************************************************************
\ The things in a room: enemies, pickups, the grenade, and enemy bolts.
\
\ Thing numbers (render.6502's slots, drawn in this order):
\   PL          the player (player.6502)
\   1-NSHOTS    the player's bolts
\   GR          the grenade, and its blast
\   TH0...      the room's things, from its list (rooms/rooms.txt)
\   EB0...      the enemies' bolts
\
\ Each enemy belongs to a phase (type_phase): out of it, it's drawn as its
\ ghost (the sprite after its own), it can't hurt and can't be hurt, and
\ it moves on as if nothing had happened. A thing killed or taken stays
\ gone (room_gone), for the rest of the game.
\ ***************************************************************************

GR = NSHOTS + 1
TH0 = GR + 1
NTH = 6
EB0 = TH0 + NTH
NEB = 2
ASSERT EB0 + NEB = NOBJ

\ By type (TH_*): sprite, phase, bolts it takes (0: only a grenade kills
\ it), and score in hundreds (BCD).
.type_spr   EQUB SPR_SENTRY, SPR_DRONE0, SPR_CRAWLER0, SPR_SHARD0
            EQUB SPR_CELL0, SPR_GRENADES0, SPR_LIFE0, SPR_CAGE
.type_phase EQUB 1, 1, 1, 2, 0, 0, 0, 0
.type_hp    EQUB 0, 1, 2, 1, 0, 0, 0, 0
.type_score EQUB &05, &01, &02, &01, &01, &01, &01, &00
ASSERT TH_SENTRY = 0 AND TH_DRONE = 1 AND TH_CRAWLER = 2 AND TH_SHARD = 3
ASSERT TH_CELL = 4 AND TH_GRENADES = 5 AND TH_LIFE = 6
TH_ENEMIES = TH_CELL            ; types below are enemies

\ The drone's bob, in lines from where it started.
.bob_tab    EQUB 0, 1, 2, 3, 3, 4, 4, 4, 4, 4, 3, 3, 2, 1, 0, 0
            EQUB 0, -1, -2, -3, -3, -4, -4, -4, -4, -4, -3, -3, -2, -1, 0, 0
\ A pickup's bob: lines up from where it lies.
.pickup_bob EQUB 0, 1, 2, 1
\ The grenade's arc: lines a frame, up negative.
.arc_tab    EQUB -5, -4, -4, -3, -3, -2, -2, -1, -1, 0, 0, 1, 1, 2, 2, 3, 3, 4, 4, 5
ARC_LEN = P% - arc_tab
ARC_FALL = 11                   ; where the arc starts to fall (a roll off an edge)
GR_FRAMES = 40                  ; it goes off after this long anyway
BOOM_FRAMES = 8
SENTRY_GAP = 48                 ; frames between a sentry's shots
SENTRY_WARN = 12                ; frames of its warning look before each
HURT_FRAMES = 6                 ; a wounded enemy's flicker
SENTRY_GUN = 1                  ; its bolt's top, below its own
ASSERT PL_H - 16 + SENTRY_GUN + 3 <= PL_CROUCH_TOP   ; (a sergeant is 16 high)

\ Into a new room: the shots and blasts gone, the room's things out.
.spawn_things
{
    ZA_AUTO1 st_n, st_k, st_x, st_y, st_arg
    LDX #NOBJ - 1
.clear
    CPX #PL : BEQ next_clear
    LDA #&FF : STA obj_spr,X
    LDA #0 : STA th_boom,X
.next_clear
    DEX : BNE clear
    LDA things_ptr : STA rd_ptr
    LDA things_ptr+1 : STA rd_ptr+1
    JSR rd_byte : STA st_n
    LDA #0 : STA st_k
.thing
    LDA st_k : CMP st_n : BCS to_done
    CMP #NTH : BCC more
.to_done
    JMP done
.more
    JSR rd_byte : PHA
    JSR rd_byte : STA st_x
    JSR rd_byte : STA st_y
    JSR rd_byte : STA st_arg
    PLA
    \ Still there?
    LDX room : LDY st_k
    PHA : LDA room_gone,X : AND bit_masks,Y : TAY : PLA
    CPY #0 : BNE skip
    PHA : LDA st_k : CLC : ADC #TH0 : TAX : PLA
    STA th_type,X
    TAY
    LDA type_spr,Y : STA obj_spr,X
    LDA type_phase,Y : STA th_phase,X
    LDA type_hp,Y : STA th_hp,X
    LDA st_x : ASL A : ASL A : STA obj_x,X
    LDA st_y : ASL A : ASL A : ASL A
    CPY #TH_CRAWLER : BNE not_crawler
    CLC : ADC #4                    ; (12 lines high: its tracks on the floor)
.not_crawler
    STA obj_y,X : STA th_y0,X
    LDA st_arg : AND #1 : ASL A : STA obj_face,X    ; 1: facing left
    LDA st_k : STA th_idx,X
    ASL A : ASL A : ASL A : STA th_t,X  ; (staggered, so they don't fire together)
    LDA #0 : STA th_boom,X : STA th_hurt,X
    LDA #OS_CHANGED : STA obj_st,X
    JSR th_look
.skip
    INC st_k
    JMP thing
.done
    RTS
}
.bit_masks EQUB 1, 2, 4, 8, 16, 32, 64, 128

\ Is thing X in this phase? Z set (BEQ) if so.
.th_in_phase
{
    LDA th_phase,X : BEQ yes
    SEC : SBC #1 : CMP phase
.yes
    RTS
}

\ Thing X's sprite: its type's, the second frame on alternate beats for
\ those that have one, and its ghost out of phase.
.th_look
{
    LDA th_boom,X : BEQ alive
    CMP #BOOM_FRAMES / 2 + 1 : LDA #SPR_BOOM0 : BCS boom
    LDA #SPR_BOOM1
.boom
    JMP set
.alive
    LDY th_type,X
    LDA type_spr,Y
    CPY #TH_SENTRY : BNE not_sentry
    \ A sergeant in phase shows its warning look before it fires.
    PHA : JSR th_in_phase : BNE calm
    LDA th_t,X : CMP #SENTRY_GAP - SENTRY_WARN : BCC calm
    PLA : CLC : ADC #SPR_SENTRY1 - SPR_SENTRY : JMP set
.calm
    PLA : JMP one_frame
.not_sentry
    CPY #TH_EXIT : BEQ one_frame
    CPY #TH_ENEMIES : BCC two_frames
    \ A pickup glints, a beat in every four.
    PHA
    LDA th_t,X : AND #12 : BNE no_glint
    PLA : CLC : ADC #4 : BNE set    ; (cell1 is cell0 + 4)
.no_glint
    PLA : JMP set
.two_frames
    PHA
    LDA th_t,X : AND #4 : STA tl_f
    ASL A : ADC tl_f : STA tl_f     ; 0 or 12: drone1 is drone0 + 12
    PLA : CLC : ADC tl_f
.one_frame
    PHA
    \ Wounded: every other frame its ghost's look, a flicker.
    LDA th_hurt,X : BEQ unhurt
    DEC th_hurt,X
    AND #1 : BEQ unhurt
    PLA : CLC : ADC #8 : JMP set
.unhurt
    JSR th_in_phase : BEQ in
    \ Out of phase: its ghosts in turn, so it shimmers.
    LDA th_t,X : AND #2 : ASL A : ADC #4 : STA tl_f   ; 4 or 8
    PLA : CLC : ADC tl_f : BNE set
.in
    PLA
.set
    CMP obj_spr,X : BEQ same
    STA obj_spr,X
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
.same
    RTS
.tl_f EQUB 0
}
ASSERT SPR_SENTRY1 = SPR_SENTRY + 12
ASSERT SPR_DRONE1 = SPR_DRONE0 + 12 AND SPR_CRAWLER1 = SPR_CRAWLER0 + 12 AND SPR_SHARD1 = SPR_SHARD0 + 12
ASSERT SPR_SENTRY_GHOST = SPR_SENTRY + 4 AND SPR_SENTRY_GHOST2 = SPR_SENTRY + 8
ASSERT SPR_DRONE0_GHOST2 = SPR_DRONE0 + 8 AND SPR_SHARD1_GHOST2 = SPR_SHARD1 + 8
ASSERT SPR_CELL1 = SPR_CELL0 + 4 AND SPR_GRENADES1 = SPR_GRENADES0 + 4 AND SPR_LIFE1 = SPR_LIFE0 + 4

\ Thing X's box (ox0-ox1, oy0-oy1), from its sprite.
.th_box
{
    LDY obj_spr,X
    LDA obj_x,X : STA ox0
    LDA spr_w,Y : ASL A : CLC : ADC ox0 : STA ox1
    LDA obj_y,X : STA oy0
    CLC : ADC spr_h,Y : STA oy1
    RTS
}

\ The player's box (bx0-bx1, by0-by1).
.pl_box
{
    LDA obj_x + PL : CLC : ADC #PL_BOX_L : STA bx0
    ADC #PL_BOX_R - PL_BOX_L + 1 : STA bx1
    LDA obj_y + PL : LDY pl_crouch : BEQ standing
    CLC : ADC #PL_CROUCH_TOP
.standing
    STA by0
    LDA obj_y + PL : CLC : ADC #PL_H : STA by1
    RTS
}

\ Do the boxes o and b overlap? Carry set if so.
.boxes_overlap
{
    LDA ox0 : CMP bx1 : BCS no
    LDA bx0 : CMP ox1 : BCS no
    LDA oy0 : CMP by1 : BCS no
    LDA by0 : CMP oy1 : BCS no
    SEC
    RTS
.no
    CLC
    RTS
}

\ Each thing, each frame.
.things_update
{
    LDX #TH0
.thing
    LDA obj_spr,X : CMP #&FF : JEQ next
    INC th_t,X
    LDA th_boom,X : BEQ alive
    DEC th_boom,X : BNE look
    \ Done exploding: gone.
    LDA #&FF : STA obj_spr,X
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
    JMP next
.alive
    \ Its own phase's tiles, whatever ours is.
    LDY th_phase,X : CPY #2 : BNE red_tiles
    LDA #LO(attr_blue) : STA attr_ptr
    LDA #HI(attr_blue) : STA attr_ptr+1
    BNE moved                       ; (always)
.red_tiles
    LDA #LO(attr_red) : STA attr_ptr
    LDA #HI(attr_red) : STA attr_ptr+1
.moved
    LDA th_type,X
    CMP #TH_DRONE : BNE not_drone
    JSR drone_move : JMP look
.not_drone
    CMP #TH_CRAWLER : BNE not_crawler
    JSR crawler_move : JMP look
.not_crawler
    CMP #TH_SHARD : BNE not_shard
    JSR shard_move : JMP look
.not_shard
    CMP #TH_SENTRY : BNE not_sentry
    JSR sentry_fire : JMP look
.not_sentry
    CMP #TH_EXIT : BEQ look
    \ A pickup bobs.
    LDA th_t,X : LSR A : LSR A : LSR A : AND #3 : TAY
    LDA th_y0,X : SEC : SBC pickup_bob,Y
    CMP obj_y,X : BEQ look
    STA obj_y,X
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
.look
    JSR th_look
    LDA th_boom,X : JNE next
    \ It meets the player, or the player's bolts. Only in phase.
    JSR th_in_phase : JNE next
    LDA pl_dead : JNE next
    JSR th_box
    JSR pl_box
    JSR boxes_overlap : BCC no_touch
    LDA th_type,X : CMP #TH_ENEMIES : BCS pickup
    JSR player_hit
    JMP next
.pickup
    CMP #TH_EXIT : BEQ cage
    JSR take
    JMP next
.cage
    STA cage_go                     ; (non-zero)
    JMP next
.no_touch
    LDA th_type,X : CMP #TH_ENEMIES : BCS next
    STX tu_x
    LDY #NSHOTS
.bolt
    LDA obj_spr,Y : CMP #&FF : BEQ no_bolt
    LDA th_boom,Y : BNE no_bolt     ; (a spark)
    LDA obj_x,Y : STA bx0 : CLC : ADC #4 : STA bx1
    LDA obj_y,Y : STA by0 : CLC : ADC #3 : STA by1
    JSR boxes_overlap : BCC no_bolt
    \ Hit: the thing takes it, or its armour does. The bolt's gone if it
    \ killed, or else it sparks, so the player sees it land.
    LDA th_hp,X : BEQ armoured
    DEC th_hp,X : BEQ killed
    JSR bolt_spark
    LDA #HURT_FRAMES : STA th_hurt,X    ; (it flickers: wounded)
    JMP no_bolt
.killed
    LDA #&FF : STA obj_spr,Y
    LDA obj_st,Y : ORA #OS_CHANGED : STA obj_st,Y
    JSR th_kill
    JMP bolts_done
.armoured
    \ Armour: the spark flies back the way the bolt came, a ricochet.
    LDA shot_dx,Y : PHA
    JSR bolt_spark                  ; (which stops it)
    PLA : EOR #&FF : CLC : ADC #1 : CMP #&80 : ROR A : STA shot_dx,Y
    JSR sound_ping
.no_bolt
    DEY : BNE bolt
.bolts_done
    LDX tu_x
.next
    INX : CPX #TH0 + NTH : JNE thing
    JMP set_tile_ptrs               ; (attr_ptr back to this phase's)
.tu_x EQUB 0
\ Bolt Y sparks; X kept.
.bolt_spark
    STX tu_x : TYA : TAX : JSR spark : TXA : TAY : LDX tu_x
    RTS
}

\ Thing X dies: it explodes, it scores, and it stays dead.
.th_kill
{
    LDA #BOOM_FRAMES : STA th_boom,X
    JSR th_gone
    LDY th_type,X
    STX tk_x
    LDA type_score,Y : JSR add_score
    LDX tk_x
    JSR th_look
    JMP sound_boom
.tk_x EQUB 0
}

\ Thing X stays gone from this room.
.th_gone
{
    LDY th_idx,X
    STX tg_x
    LDX room
    LDA room_gone,X : ORA bit_masks,Y : STA room_gone,X
    LDX tg_x
    RTS
.tg_x EQUB 0
}

\ The player takes pickup X.
.take
{
    JSR th_gone
    LDA #&FF : STA obj_spr,X
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
    STX tk_x
    LDY th_type,X
    LDA type_score,Y : JSR add_score
    LDX tk_x
    LDA th_type,X
    CMP #TH_CELL : BNE not_cell
    LDA cells : CLC : ADC #3 : CMP #10 : BCC c_ok
    LDA #9
.c_ok
    STA cells
    JMP counted
.not_cell
    CMP #TH_GRENADES : BNE not_gren
    LDA grenades : CLC : ADC #3 : CMP #10 : BCC g_ok
    LDA #9
.g_ok
    STA grenades
    JMP counted
.not_gren
    CMP #TH_LIFE : BNE counted
    LDA lives : CMP #9 : BCS counted
    INC lives
    JSR show_counts
    LDX tk_x
    JMP sound_life                  ; (a trauma kit has its own sound)
.counted
    JSR show_counts
    LDX tk_x
    JMP sound_take
.tk_x EQUB 0
}

\ --- How each enemy moves ----------------------------------------------------

\ A drone: across, turning at walls and the screen's edges, bobbing.
.drone_move
{
    JSR walk : BEQ ok
    JSR turn
.ok
    LDA th_t,X : LSR A : AND #31 : TAY
    LDA th_y0,X : CLC : ADC bob_tab,Y : STA obj_y,X
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
    RTS
}

\ A crawler: along the floor every other frame, turning at walls and at
\ the floor's end.
.crawler_move
{
    LDA th_t,X : AND #1 : BNE done
    JSR walk : BNE turn_round
    \ Ground ahead? Under the leading edge.
    JSR lead_col : STA ta_c0 : STA ta_c1
    LDY obj_spr,X
    LDA obj_y,X : CLC : ADC spr_h,Y : LSR A : LSR A : LSR A
    STA ta_r0 : STA ta_r1
    STX cm_x
    LDA #TF_SOLID : JSR test_area
    PHP : LDX cm_x : PLP
    BNE moved
    \ No: back, and round.
    LDA obj_face,X : BEQ was_right
    INC obj_x,X : INC obj_x,X
.was_right
    DEC obj_x,X
.turn_round
    JSR turn
.moved
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
.done
    RTS
.cm_x EQUB 0
}

\ A shard: towards the player, a step at a time, every other frame. Out
\ of phase it hangs still: a ghost that homed would sit on the player,
\ to kill them the moment they shifted (decision 15).
.shard_move
{
    LDA th_t,X : AND #1 : BNE done
    JSR th_in_phase : BNE done
    LDA obj_x + PL : CLC : ADC #2 : CMP obj_x,X
    BEQ y_axis : BCC left
    INC obj_x,X
    JSR th_solid : BEQ y_axis
    DEC obj_x,X : JMP y_axis        ; (a wall: not that way)
.left
    DEC obj_x,X
    JSR th_solid : BEQ y_axis
    INC obj_x,X
.y_axis
    LDA obj_y + PL : CLC : ADC #8 : CMP obj_y,X
    BEQ moved : BCC up
    INC obj_y,X : INC obj_y,X
    JSR th_solid : BEQ moved
    DEC obj_y,X : DEC obj_y,X : JMP moved
.up
    DEC obj_y,X : DEC obj_y,X
    JSR th_solid : BEQ moved
    INC obj_y,X : INC obj_y,X
.moved
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
.done
    RTS
}

\ Is anything solid (in thing X's own phase: attr_ptr) under thing X's
\ box? Z clear (BNE) if so. X is kept.
.th_solid
{
    JSR th_box
    LDA ox0 : LSR A : LSR A : STA ta_c0
    LDA ox1 : SEC : SBC #1 : LSR A : LSR A : STA ta_c1
    LDA oy0 : LSR A : LSR A : LSR A : STA ta_r0
    LDA oy1 : SEC : SBC #1 : LSR A : LSR A : LSR A : STA ta_r1
    STX ts_x
    LDA #TF_SOLID : JSR test_area
    PHP : LDX ts_x : PLP
    RTS
.ts_x EQUB 0
}

\ Thing X steps the way it faces, unless the screen's edge or something
\ solid is in the way. Z clear (BNE) if it was stopped.
.walk
{
    LDA obj_face,X : BNE leftward
    JSR th_box
    LDA ox1 : CMP #128 : BCS blocked
    INC obj_x,X
    JSR lead_tiles : BNE undo_r
    LDA #0
    RTS
.undo_r
    DEC obj_x,X
    BNE blocked                     ; (always: something was there)
.leftward
    LDA obj_x,X : BEQ blocked
    DEC obj_x,X
    JSR lead_tiles : BEQ ok
    INC obj_x,X
.blocked
    LDA #1
.ok
    RTS
}

\ The column of tiles at thing X's leading edge.
.lead_col
{
    LDA obj_face,X : BNE leftward
    JSR th_box
    LDA ox1 : SEC : SBC #1 : LSR A : LSR A
    RTS
.leftward
    LDA obj_x,X : LSR A : LSR A
    RTS
}

\ Anything solid in the leading edge's column, over thing X's height?
\ Z clear (BNE) if so. X is kept.
.lead_tiles
{
    JSR lead_col : STA ta_c0 : STA ta_c1
    LDY obj_spr,X
    LDA obj_y,X : LSR A : LSR A : LSR A : STA ta_r0
    LDA obj_y,X : CLC : ADC spr_h,Y : SEC : SBC #1
    LSR A : LSR A : LSR A : STA ta_r1
    STX lt_x
    LDA #TF_SOLID : JSR test_area
    PHP : LDX lt_x : PLP
    RTS
.lt_x EQUB 0
}

\ Thing X turns round.
.turn
    LDA obj_face,X : EOR #2 : STA obj_face,X
    RTS

\ A sentry fires every so often, along its row, if the player's in reach
\ of it and it's in phase.
.sentry_fire
{
    LDA th_t,X : CMP #SENTRY_GAP : BCC done
    LDA #0 : STA th_t,X
    JSR th_in_phase : BNE done
    LDA pl_dead : BNE done
    \ Only at a player about level with it.
    LDA obj_y + PL : CLC : ADC #8 : SEC : SBC obj_y,X
    BCS below : EOR #&FF : ADC #1
.below
    CMP #24 : BCS done
    LDY #EB0 + NEB - 1
.find
    LDA obj_spr,Y : CMP #&FF : BEQ free
    DEY : CPY #EB0 : BCS find
.done
    RTS
.free
    LDA #SPR_EBOLT : STA obj_spr,Y
    LDA #OS_CHANGED : STA obj_st,Y
    \ From the gun on top of its head: high enough that a crouch ducks it
    \ (on one floor, the bolt's foot is above the crouched box's top).
    LDA obj_y,X : CLC : ADC #SENTRY_GUN : STA obj_y,Y
    LDA obj_face,X : BNE leftward
    LDA #3 : STA shot_dx,Y
    LDA obj_x,X : CLC : ADC #8 : STA obj_x,Y
    JMP sound_zap
.leftward
    LDA #256 - 3 : STA shot_dx,Y
    LDA obj_x,X : SEC : SBC #4 : BCS on
    LDA #0
.on
    STA obj_x,Y
    JMP sound_zap
}

\ The enemies' bolts: across until they hit something or the player.
.ebolts_update
{
    LDX #EB0
.bolt
    LDA obj_spr,X : CMP #&FF : BEQ next
    LDA obj_x,X : CLC : ADC shot_dx,X
    CMP #128 - 4 + 1 : BCS gone
    STA obj_x,X
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
    STX eb_x
    LDA obj_x,X : CLC : ADC #2 : LSR A : LSR A : STA ta_c0 : STA ta_c1
    LDA obj_y,X : CLC : ADC #1 : LSR A : LSR A : LSR A : STA ta_r0 : STA ta_r1
    LDA #TF_SOLID : JSR test_area
    PHP : LDX eb_x : PLP
    BNE gone
    LDA pl_dead : BNE next
    LDA obj_x,X : STA ox0 : CLC : ADC #4 : STA ox1
    LDA obj_y,X : STA oy0 : CLC : ADC #3 : STA oy1
    JSR pl_box
    JSR boxes_overlap : BCC next
    JSR player_hit
    LDX eb_x
.gone
    LDA #&FF : STA obj_spr,X
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
.next
    INX : CPX #EB0 + NEB : BNE bolt
    RTS
.eb_x EQUB 0
}

\ --- The grenade -------------------------------------------------------------

\ SPACE: a grenade lobbed the way the player faces, if there's one to
\ throw and none in the air.
.grenade_throw
{
    LDA keys_new : AND #KB_GRENADE : BEQ done
    LDA grenades : BEQ done
    LDA obj_spr + GR : CMP #&FF : BNE done
    LDA pl_dead : BNE done
    DEC grenades
    JSR show_counts
    LDA #SPR_GRENADE : STA obj_spr + GR
    LDA #OS_CHANGED : STA obj_st + GR
    LDA #0 : STA gr_i : STA th_boom + GR : STA th_t + GR
    \ Crouching, it's rolled along the floor instead: under a sergeant's
    \ fire, into its plinth (decision 25).
    LDA pl_crouch : STA gr_roll
    LDA #4 : LDY pl_crouch : BEQ lob
    LDA #PL_H - 4
.lob
    CLC : ADC obj_y + PL : STA obj_y + GR
    LDA obj_x + PL : CLC : ADC #3 : STA obj_x + GR
    LDA obj_face + PL : BNE left
    LDA #2 : BNE set                ; (always)
.left
    LDA #256 - 2
.set
    STA shot_dx + GR
    JMP sound_fire
.done
    RTS
}

\ The grenade in the air, and its blast.
.grenade_update
{
    LDA obj_spr + GR : CMP #&FF : BEQ done
    LDA th_boom + GR : BEQ flying
    DEC th_boom + GR : BNE blasting
    LDA #&FF : STA obj_spr + GR
    LDA obj_st + GR : ORA #OS_CHANGED : STA obj_st + GR
.done
    RTS
.blasting
    LDA #SPR_BOOM0 : LDY th_boom + GR : CPY #BOOM_FRAMES / 2 + 1 : BCS set_boom
    LDA #SPR_BOOM1
.set_boom
    STA obj_spr + GR
    LDA obj_st + GR : ORA #OS_CHANGED : STA obj_st + GR
    RTS
.flying
    INC th_t + GR
    LDA th_t + GR : CMP #GR_FRAMES : BCC in_time
    JMP grenade_bang
.in_time
    LDA obj_st + GR : ORA #OS_CHANGED : STA obj_st + GR
    LDA obj_x + GR : CLC : ADC shot_dx + GR
    CMP #128 - 2 + 1 : BCC across
    JMP grenade_bang                ; (the screen's edge)
.across
    STA obj_x + GR
    LDA gr_roll : BEQ arc
    \ Rolling: on along the floor while there is one, or else falling.
    LDA obj_x + GR : CLC : ADC #1 : LSR A : LSR A : STA ta_c0 : STA ta_c1
    LDA obj_y + GR : CLC : ADC #4 : LSR A : LSR A : LSR A : STA ta_r0 : STA ta_r1
    LDA #TF_SOLID : JSR test_area : BNE hits
    LDA #0 : STA gr_roll
    LDA #ARC_FALL : STA gr_i
.arc
    LDX gr_i : CPX #ARC_LEN - 1 : BCS fast
    INC gr_i
.fast
    LDA obj_y + GR : CLC : ADC arc_tab,X
    CMP #PLAY_LINES - 4 : BCS bang
    STA obj_y + GR
.hits
    \ Into anything solid, or any enemy in phase: bang.
    LDA obj_x + GR : CLC : ADC #1 : LSR A : LSR A : STA ta_c0 : STA ta_c1
    LDA obj_y + GR : CLC : ADC #2 : LSR A : LSR A : LSR A : STA ta_r0 : STA ta_r1
    LDA #TF_SOLID : JSR test_area : BNE bang
    LDA obj_x + GR : STA bx0 : CLC : ADC #2 : STA bx1
    LDA obj_y + GR : STA by0 : CLC : ADC #4 : STA by1
    LDX #TH0
.hit
    LDA obj_spr,X : CMP #&FF : BEQ no_hit
    LDA th_boom,X : BNE no_hit
    LDA th_type,X : CMP #TH_ENEMIES : BCS no_hit
    JSR th_in_phase : BNE no_hit
    JSR th_box
    JSR boxes_overlap : BCS bang
.no_hit
    INX : CPX #TH0 + NTH : BNE hit
    RTS
.bang
    JMP grenade_bang
}

\ The grenade goes off: a blast a little bigger than its sprite, which
\ kills any enemy in phase it touches, armoured or not, and clears any
\ breakable tile three wide and four high about it: its own row, one
\ above and two below. A grenade thrown at a wall goes off level with
\ the player's head, and the two below reach their feet (decision 17).
\ A breakable tile takes those above and below it with it: a cracked
\ wall comes down whole, or a grenade that rose over its foot could
\ leave a stub no grenade can reach (decision 18).
.grenade_bang
{
    ZA_AUTO1 gb_c, gb_r, gb_cx, gb_ry
    LDA #BOOM_FRAMES : STA th_boom + GR
    LDA #SPR_BOOM0 : STA obj_spr + GR
    LDA obj_st + GR : ORA #OS_CHANGED : STA obj_st + GR
    \ The boom's 16x16 centred on the grenade (4x4): 6 pixels left and up.
    LDA obj_x + GR : SEC : SBC #3 : BCS x_ok
    LDA #0
.x_ok
    CMP #128 - 8 : BCC x_in
    LDA #128 - 8
.x_in
    STA obj_x + GR
    LDA obj_y + GR : SEC : SBC #6 : BCS y_ok
    LDA #0
.y_ok
    CMP #PLAY_LINES - 16 : BCC y_in
    LDA #PLAY_LINES - 16
.y_in
    STA obj_y + GR
    JSR sound_boom
    \ The enemies it catches.
    LDA obj_x + GR : SEC : SBC #2 : BCS bx_ok
    LDA #0
.bx_ok
    STA bx0
    LDA obj_x + GR : CLC : ADC #10 : STA bx1
    LDA obj_y + GR : SEC : SBC #4 : BCS by_ok
    LDA #0
.by_ok
    STA by0
    LDA obj_y + GR : CLC : ADC #20 : STA by1
    LDX #TH0
.enemy
    LDA obj_spr,X : CMP #&FF : BEQ no_enemy
    LDA th_boom,X : BNE no_enemy
    LDA th_type,X : CMP #TH_ENEMIES : BCS no_enemy
    JSR th_in_phase : BNE no_enemy
    JSR th_box
    JSR boxes_overlap : BCC no_enemy
    JSR th_kill
.no_enemy
    INX : CPX #TH0 + NTH : BNE enemy
    \ The tiles: centred on the boom's middle.
    LDA obj_x + GR : CLC : ADC #4 : LSR A : LSR A : STA gb_cx
    LDA obj_y + GR : CLC : ADC #8 : LSR A : LSR A : LSR A : STA gb_ry
    LDA #0 : STA gb_broke
    LDA gb_ry : SEC : SBC #1 : STA gb_r
.row
    LDA gb_cx : SEC : SBC #1 : STA gb_c
.col
    LDA gb_c : CMP #MAP_W : BCS no_tile
    LDA gb_r : CMP #MAP_H : BCS no_tile
    TAY
    JSR gb_break : BCC no_tile
    \ The breakable tiles above it and below it come down too.
    LDY gb_r
.up
    DEY : BMI up_done               ; (above row 0)
    JSR gb_break : BCS up
.up_done
    LDY gb_r
.down
    INY : CPY #MAP_H : BCS no_tile
    JSR gb_break : BCS down
.no_tile
    INC gb_c
    LDA gb_c : SEC : SBC gb_cx : CMP #2 : BNE col
    INC gb_r
    LDA gb_r : SEC : SBC gb_ry : CMP #3 : BNE row
    \ Tiles redrawn under things: draw them all again.
    LDA gb_broke : BEQ done
    JMP objs_touch
.done
    RTS
.gb_broke EQUB 0

\ Break tile (gb_c, row Y) if it's breakable: carry set if it was. Y kept.
.gb_break
    STY gk_r
    LDA maprow_lo,Y : STA gb_ptr
    LDA maprow_hi,Y : STA gb_ptr+1
    LDY gb_c
    LDA (gb_ptr),Y : TAX
    LDA tile_attr,X : AND #TF_BREAKABLE : BEQ not_breakable
    LDA #T_EMPTY : STA (gb_ptr),Y   ; (air: drawn as the back wall)
    LDX gb_c : LDY gk_r : JSR draw_tile_xy
    INC gb_broke
    LDY gk_r
    SEC
    RTS
.not_breakable
    LDY gk_r
    CLC
    RTS
.gk_r EQUB 0
}
gb_ptr = text_ptr                   ; (fixed zero page: nothing prints here)
