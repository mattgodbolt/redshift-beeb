\ ***************************************************************************
\ System: the keyboard and the sound chip, straight from the System VIA
\ (after chuckie-egg-2-beeb's system.6502 and sound.6502), so the game makes
\ no OS calls once it's running.
\ ***************************************************************************

\ Is a key down? X = internal key number. Z clear (BNE) if it is.
.key_down
    LDA #&7F : STA sysvia_ddra      ; bits 0-6 the key, bit 7 its state
    LDA #3 : STA sysvia_orb         ; auto-scan off: the matrix is ours
    STX sysvia_ora_nh
    LDA sysvia_ora_nh : AND #&80
    RTS

\ Write A to the sound chip, through the System VIA's slow bus. X is kept.
.sound_write
{
    PHP : SEI                       ; (the interrupt's sound_tick writes too)
    \ The keyboard off the bus first: key_down leaves it enabled, and then
    \ it drives port A's bit 7 (the addressed key's state), which would
    \ replace the byte's top bit.
    LDY #&0B : STY sysvia_orb
    LDY #&FF : STY sysvia_ddra
    STA sysvia_ora_nh
    LDY #0 : STY sysvia_orb         ; write enable low
    LDY #3                          ; ... for 8us
.hold
    DEY : BNE hold
    LDY #8 : STY sysvia_orb
    PLP
    RTS
}
