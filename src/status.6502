\ ***************************************************************************
\ The status bar: the score, then an icon and a count each for phase cells,
\ fracture charges and lives; under them the room's name, over a dotted
\ rule (print_at draws it) that keeps the bar off the playfield.
\
\   SCORE 000000         c5  g5  l5
\             LANDING ZONE
\ ***************************************************************************

\ The icons, drawn over characters the bar never prints (grab_font).
ICON_CELL = 91 : ICON_GREN = 92 : ICON_LIFE = 93   ; ('[', backslash, ']')
COL_CELL = 21 : COL_GREN = 25 : COL_LIFE = 29

.draw_status
{
    PRINT_AT 0, 0, top_text
    PRINT_AT 0, 1, blank_text
    \ The room's name, centred: a title, apart from the counts above it.
    LDA room_name : STA text_ptr
    LDA room_name+1 : STA text_ptr+1
    LDY #0
.length
    LDA (text_ptr),Y : BEQ measured
    INY : BNE length
.measured
    STY ds_len
    LDA #SCREEN_COLS : SEC : SBC ds_len : LSR A : TAX
    LDY #1 : JSR print_at
    JSR show_score
    JMP show_counts
.top_text   EQUS "SCORE 000000         "
.top_icons  EQUB ICON_CELL, '5', ' ', ' ', ICON_GREN, '5', ' ', ' ', ICON_LIFE, '5', ' ', 0
.blank_text EQUS "                                ", 0
.ds_len EQUB 0
ASSERT top_icons - top_text = COL_CELL AND COL_GREN = COL_CELL + 4 AND COL_LIFE = COL_CELL + 8
}

\ The score's six digits.
.show_score
{
    LDX #6 : LDY #0 : JSR print_at.locate
    LDX #2
.byte
    LDA score,X : LSR A : LSR A : LSR A : LSR A : JSR digit
    LDA score,X : AND #15 : JSR digit
    DEX : BPL byte
    RTS
.digit
    STX sd_x
    ORA #'0' : JSR print_at.print_char_a
    LDX sd_x
    RTS
.sd_x EQUB 0
}

\ Cells, grenades and lives: a digit each, after its icon.
.show_counts
{
    LDA cells : ORA #'0' : LDX #COL_CELL + 1 : LDY #0 : JSR print_at.print_char_at
    LDA grenades : ORA #'0' : LDX #COL_GREN + 1 : LDY #0 : JSR print_at.print_char_at
    LDA lives : ORA #'0' : LDX #COL_LIFE + 1 : LDY #0 : JMP print_at.print_char_at
}

\ Score A hundred points (A in BCD), and a life for every 10,000.
.add_score
{
    LDX score+2 : STX as_10k
    SED
    CLC : ADC score+1 : STA score+1
    LDA score+2 : ADC #0 : STA score+2
    CLD
    CMP as_10k : BEQ same
    LDA lives : CMP #9 : BCS same
    INC lives
    JSR show_counts
    JSR sound_take
.same
    JMP show_score
.as_10k EQUB 0
}
