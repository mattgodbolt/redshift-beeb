\ ***************************************************************************
\ THE HINGE (decision 58): the one thing in the mine that's in both phases
\ at once. In the Red it's a Drill Sergeant the size of a house; in the
\ Blue, a crystal bloom that sheds Slivers. It's tiles, each a picture in
\ each phase (gfx/tiles.txt's "blue" blocks), and the room's thing "hinge"
\ marks its heart: the plate's two cells in the Red, the crystal over the
\ core in the Blue. Its tiles are solid in both phases.
\
\ A round of the fight:
\ 1. In the Red, charges burst on the plate dent it, and crack it
\    (HG_PLATE), and the crystal cracks with it, open on the core.
\ 2. In the Blue, a bolt into the core through the crack, before the
\    crystal grows back (hg_crack, its last HG_SHUT frames a slit), puts out
\    a lamp in its visor. The crack snaps shut and the next round, a faster
\    one, begins. A crack that closes unshot is a round to try again.
\ The last lamp out, the Hinge folds shut (endings.6502).
\
\ Its gun covers Ash's head in its row, and fires, its muzzle lit first,
\ while Ash is in the Red and in its line; a crouch ducks it, as a
\ sergeant's. Out of its line or out of the Red, its clock goes round short
\ of its warning, as a sergeant's does (decision 47). Its bud sheds a
\ Sliver in front of it, lit first, while Ash is in the Blue and the swarm
\ isn't full; otherwise its clock waits just short of its warning, so it
\ sheds soon after Ash comes into the Blue, but never without warning.
\
\ The game finds its gun, its bud and its lamps on the map, by their looks
\ (Sector 5's own, named by mkgfx.py for their chains), when the room is
\ read; and changes them on the map, drawn again as the machinery's parts
\ are (render). A death reads the room again: the fight from its start
\ (decision 30).
\ ***************************************************************************

HG_PLATE = 2                    ; charges that crack the plate, each round
HG_WARN = 12                    ; frames of the gun's or the bud's warning
HG_SHUT = 50                    ; the crack's last frames: a slit, closing
\ Each round's: frames between the gun's shots, and the bud's Slivers; the
\ most Slivers out at once; and frames the crack stays open.
HG_GUN = {50, 40, 32}
HG_SHED = {50, 40, 32}
HG_SWARM = {2, 3, 4}
HG_CRACK = {150, 125, 100}
ASSERT LEN(HG_GUN) = HG_ROUNDS AND LEN(HG_SHED) = HG_ROUNDS
ASSERT LEN(HG_SWARM) = HG_ROUNDS AND LEN(HG_CRACK) = HG_ROUNDS
ASSERT MIN(HG_GUN) > HG_WARN AND MIN(HG_SHED) > HG_WARN AND MIN(HG_CRACK) > HG_SHUT
ASSERT MAX(HG_SWARM) <= NTH
\ The fight starts, on arrival and after every death, with at least these:
\ a round takes a shift each way, and two charges.
HG_CELLS = 8
HG_GRENADES = 9
\ A shed Sliver's place in the room's list, for room_gone: past any thing's.
HG_IDX = 7
ASSERT HG_IDX >= NTH
\ The gun's bolt, in lines below the top of the muzzle's row: where a
\ standing Ash's head is in that row, and over a crouch, as a sergeant's.
HG_GUN_LINE = 2
ASSERT HG_GUN_LINE + SPR_EBOLT_H <= PL_CROUCH_TOP AND HG_GUN_LINE < PL_H

\ The plate's looks, top then bottom, in the order mkgfx.py numbers them.
HP_WHOLE = 0 : HP_DENT = 1 : HP_OPEN = 2 : HP_SHUT = 3
ASSERT T_HINGE_HEART_B = T_HINGE_HEART_T + 1
ASSERT T_HINGE_DENT_T = T_HINGE_HEART_T + 2 * HP_DENT AND T_HINGE_DENT_B = T_HINGE_DENT_T + 1
ASSERT T_HINGE_OPEN_T = T_HINGE_HEART_T + 2 * HP_OPEN AND T_HINGE_OPEN_B = T_HINGE_OPEN_T + 1
ASSERT T_HINGE_SHUT_T = T_HINGE_HEART_T + 2 * HP_SHUT AND T_HINGE_SHUT_B = T_HINGE_SHUT_T + 1
ASSERT T_HINGE_MUZZLE_LIT = T_HINGE_MUZZLE + 1 AND T_HINGE_BUD_LIT = T_HINGE_BUD + 1

.hg_gun_gap     EQUB HG_GUN
.hg_gun_warn    FOR g = HG_GUN : EQUB g - HG_WARN : NEXT
.hg_shed_gap    EQUB HG_SHED
.hg_shed_warn   FOR g = HG_SHED : EQUB g - HG_WARN : NEXT
.hg_swarm       EQUB HG_SWARM
.hg_crack       EQUB HG_CRACK

\ The room's thing "hinge": its heart at cell A, row Y. The fight from its
\ start, and its gun, bud and lamps found on the map.
.hinge_spawn
{
    ZA_AUTO2 hp_map
    ZA_AUTO1 hp_row
    STA hg_hx : STY hg_hy
    LDA #0
    STA hg_won : STA hg_round : STA hg_plate : STA hg_open
    STA hg_gun_t : STA hg_shed_t : STA hg_warn : STA hg_lamps
    ASSERT HP_WHOLE = 0
    STA hg_shown
    LDA #&FF : STA hg_mx : STA hg_bx
    INC hinge_on
    \ What a round needs, at the least.
    LDA cells : CMP #HG_CELLS : BCS cells_ok
    LDA #HG_CELLS : STA cells
.cells_ok
    LDA grenades : CMP #HG_GRENADES : BCS grenades_ok
    LDA #HG_GRENADES : STA grenades
.grenades_ok
    JSR show_counts
    \ The rest of it, by its looks: the map read from the bottom right.
    LDY #MAP_H - 1
.row
    STY hp_row
    LDA maprow_lo,Y : STA hp_map
    LDA maprow_hi,Y : STA hp_map+1
    LDY #MAP_W - 1
.col
    LDA (hp_map),Y
    CMP #T_HINGE_MUZZLE : BNE not_gun
    STY hg_mx
    LDA hp_row : STA hg_my
.not_gun
    CMP #T_HINGE_BUD : BNE not_bud
    STY hg_bx
    LDA hp_row : STA hg_by
.not_bud
    CMP #T_HINGE_LAMP : BNE next
    LDX hg_lamps : CPX #HG_ROUNDS : BCS next
    TYA : STA hg_lx,X
    LDA hp_row : STA hg_ly,X
    INC hg_lamps
.next
    DEY : BPL col
    LDY hp_row
    DEY : BPL row
    RTS
}

\ Each frame, after the things: the crack's time, the gun or the bud, and
\ their looks; or, the last lamp out, the end (endings.6502).
.hinge_update
{
    LDA hinge_on : BEQ done
    LDA hg_won : BEQ fighting
    JMP hinge_win
.fighting
    LDA hg_open : BEQ shut
    DEC hg_open : BNE shut
    LDA #0 : STA hg_plate           ; (grown back: whole again)
.shut
    LDA pl_dead : BNE looks
    LDY hg_round
    LDA phase : BNE blue
    JSR hg_gun
    JSR hg_bud_wait
    JMP looks
.blue
    JSR hg_shed
    LDY hg_round
    LDA hg_gun_t : CMP hg_gun_warn,Y : BCC looks
    LDA #0 : STA hg_gun_t
.looks
    JSR hg_plate_look
    JMP hg_warn_look
.done
    RTS
}

\ In the Red: the gun fires along its row while Ash is in it, every so
\ often, its muzzle lit first. Y = the round.
.hg_gun
{
    ZA_AUTO1 hg_line
    LDA hg_mx : BMI done            ; (no gun)
    INC hg_gun_t
    LDA hg_my : ASL A : ASL A : ASL A
    ADC #HG_GUN_LINE : STA hg_line  ; (carry clear: rows are under 32)
    \ Ash in its line?
    LDA obj_y + PL : CLC : ADC #PL_H
    CMP hg_line : BCC unsighted : BEQ unsighted
    LDA hg_line : CLC : ADC #SPR_EBOLT_H : CMP obj_y + PL
    BCC unsighted : BEQ unsighted
    LDA hg_gun_t : CMP hg_gun_gap,Y : BCC done
    LDA #0 : STA hg_gun_t
    LDY #EB0 + NEB - 1
.find
    LDA obj_spr,Y : CMP #&FF : BEQ free
    DEY : CPY #EB0 : BCS find
.done
    RTS
.unsighted
    LDA hg_gun_t : CMP hg_gun_warn,Y : BCC done
    LDA #0 : STA hg_gun_t
    RTS
.free
    LDA #SPR_EBOLT : STA obj_spr,Y
    LDA #OS_CHANGED : STA obj_st,Y
    LDA hg_line : STA obj_y,Y
    LDA hg_mx : ASL A : ASL A : SEC : SBC #SPR_EBOLT_W / 2 : STA obj_x,Y
    LDA #256 - 3 : STA shot_dx,Y
    JMP sound_zap
}

\ In the Blue: the bud sheds a Sliver in front of it while the swarm isn't
\ full, every so often, lit first.
.hg_shed
{
    LDA hg_bx : BMI done            ; (no bud)
    JSR hg_count
    LDY hg_round : CMP hg_swarm,Y : BCS full
    INC hg_shed_t
    LDA hg_shed_t : CMP hg_shed_gap,Y : BCC done
    LDA #0 : STA hg_shed_t
    LDX #TH0
.find
    LDA obj_spr,X : CMP #&FF : BEQ free
    INX : CPX #TH0 + NTH : BNE find
.done
    RTS
.full
    JMP hg_bud_wait
.free
    LDA #TH_SHARD : STA th_type,X
    TAY
    LDA type_spr,Y : STA obj_spr,X
    LDA type_phase,Y : STA th_phase,X
    LDA type_hp,Y : STA th_hp,X
    LDA hg_bx : ASL A : ASL A : SEC : SBC #SPR_SHARD0_W / 2 : STA obj_x,X
    LDA hg_by : ASL A : ASL A : ASL A
    STA obj_y,X : STA th_y0,X
    LDA #0 : STA obj_face,X : STA th_boom,X : STA th_hurt,X : STA th_t,X
    LDA #HG_IDX : STA th_idx,X
    LDA #OS_CHANGED : STA obj_st,X
    JSR th_look
    JMP sound_crack
}

\ The bud waits just short of its warning, out of the Blue or with the swarm
\ full: the moment it can shed again, it warns, then sheds.
.hg_bud_wait
    LDY hg_round
    LDX hg_shed_warn,Y : DEX : STX hg_shed_t
    RTS

\ A: the Slivers out. X and Y kept.
.hg_count
{
    STX hc_x
    LDA #0
    LDX #TH0
.slot
    LDY obj_spr,X : INY : BEQ next  ; (&FF: none)
    LDY th_type,X : CPY #TH_SHARD : BNE next
    LDY th_boom,X : BNE next
    CLC : ADC #1
.next
    INX : CPX #TH0 + NTH : BNE slot
    LDX hc_x
    LDY hg_round
    RTS
.hc_x EQUB 0
}

\ A charge's blast (grenade_bang), three cells wide about column A, four
\ high from the row over Y: on the plate, in the Red, it dents it, and the
\ last cracks it, and the crystal with it.
.hinge_blast
{
    ZA_AUTO1 hb_cx
    STA hb_cx
    LDA hinge_on : BEQ done
    LDA phase : BNE done            ; (the plate's the Red's)
    LDA hg_open : BNE done          ; (cracked already)
    LDA hg_hx : SEC : SBC hb_cx : CLC : ADC #1
    CMP #3 : BCS done               ; (its column: 1 either side)
    TYA : SEC : SBC hg_hy : CLC : ADC #2
    CMP #5 : BCS done               ; (its two rows: one over, two under)
    INC hg_plate
    LDA hg_plate : CMP #HG_PLATE : BCC done
    LDY hg_round : LDA hg_crack,Y : STA hg_open
    JMP sound_crack
.done
    RTS
}

\ Bolt X has struck the tile ta_c0, ta_r0 (shots_update): it sparks, and if
\ that's the core, through the crack, in the Blue, the core takes it. X kept.
.hinge_struck
{
    JSR spark
    LDA hinge_on : BEQ done
    LDA phase : BEQ done            ; (the core's in the Blue's crystal)
    LDA hg_open : BEQ done
    LDA ta_c0 : CMP hg_hx : BNE done
    LDA ta_r0 : SEC : SBC hg_hy : CMP #2 : BCS done
    \ The core takes it: the crack snaps shut, a lamp goes out.
    STX hs_x
    LDA #0 : STA hg_open : STA hg_plate
    LDX hg_round : CPX hg_lamps : BCS lamped
    LDY hg_ly,X
    LDA hg_lx,X : TAX
    LDA #T_HINGE_LAMP_DARK : JSR hg_set
.lamped
    INC hg_round
    LDA #HG_SCORE : JSR add_score
    JSR sound_crack
    LDA hg_round : CMP hg_lamps : BCC more
    INC hg_won
.more
    LDX hs_x
.done
    RTS
.hs_x EQUB 0
}
HG_SCORE = &50                      ; (hundreds, in BCD: add_score's)

\ The plate's look, and so the crystal's, from how it is.
.hg_plate_look
{
    LDA hg_open : BEQ closed
    CMP #HG_SHUT + 1 : LDA #HP_OPEN : BCS got
    LDA #HP_SHUT : BNE got          ; (always)
.closed
    LDA hg_plate : BEQ got          ; (HP_WHOLE)
    LDA #HP_DENT
.got
    CMP hg_shown : BEQ done
    STA hg_shown
    ASL A : ADC #T_HINGE_HEART_T    ; (carry clear: the state's under 128)
    PHA
    LDX hg_hx : LDY hg_hy : JSR hg_set
    PLA : CLC : ADC #1
    LDX hg_hx : LDY hg_hy : INY : JMP hg_set
.done
    RTS
}

\ The muzzle lit while the gun warns, in the Red, and the bud while it
\ does, in the Blue; dark otherwise.
.hg_warn_look
{
    ZA_AUTO1 hw_want, hw_diff
    LDA #0 : STA hw_want
    LDY hg_round
    LDA phase : BNE blue
    LDA hg_gun_t : CMP hg_gun_warn,Y : BCC set
    LDA #1 : STA hw_want
    BNE set                         ; (always)
.blue
    LDA hg_shed_t : CMP hg_shed_warn,Y : BCC set
    LDA #2 : STA hw_want
.set
    LDA hw_want : EOR hg_warn : STA hw_diff
    LDA hw_want : STA hg_warn
    LSR hw_diff : BCC gun_same
    LDX hg_mx : BMI gun_same
    LDA hw_want : AND #1 : CLC : ADC #T_HINGE_MUZZLE
    LDY hg_my : JSR hg_set
.gun_same
    LSR hw_diff : BCC done
    LDX hg_bx : BMI done
    LDA hw_want : LSR A : CLC : ADC #T_HINGE_BUD
    LDY hg_by : JMP hg_set
.done
    RTS
}

\ Cell X, row Y becomes look A, listed to be drawn again (render's parts,
\ as the machinery's are: a frame lists a few of them at most).
.hg_set
{
    ZA_AUTO2 hs_map
    ZA_AUTO1 hs_look
    STA hs_look
    LDA maprow_lo,Y : STA hs_map
    LDA maprow_hi,Y : STA hs_map+1
    STY hs_row
    TXA : TAY
    LDA hs_look : STA (hs_map),Y
    LDY parts_n : CPY #MAX_PARTS : BCS full
    INC parts_n
    TXA : ASL A : STA parts_c0,Y
    ADC #2 : STA parts_c1,Y
    LDA hs_row : STA parts_r0,Y
    CLC : ADC #1 : STA parts_r1,Y
.full
    RTS
.hs_row EQUB 0
}
