\ ***************************************************************************
\ RSLOAD: run by !BOOT with the OS still in charge. It finds a sideways RAM
\ bank (decision 12), loads RSDATA (the shared art and the text) into main
\ RAM at &3000 and the first sector's file, its rooms and its looks, just
\ after it (decisions 42 and 43), copies both into the bank, leaves the
\ bank paged in, and runs the game, which
\ reads the bank's number from RS_BANK. While the title page waits for
\ SPACE, the title theme plays (decisions 32 and 33): a frame of the music
\ player each VSync, from the loop that waits.
\ ***************************************************************************

romtypes = &02A1                ; the OS's ROM type per bank; 0: no ROM there
RS_TRY   = &70                  ; (the loader's own zero page)
RS_RES   = &71
RS_P     = &72
RS_MU    = &74                  ; (two bytes: the title theme's place)

.rsload
{
    \ The title page, which stays up while RSDATA loads.
    LDA #LO(title_page) : STA RS_P
    LDA #HI(title_page) : STA RS_P+1
    LDY #0
.page
    LDA (RS_P),Y : JSR &FFEE
    INC RS_P : BNE same
    INC RS_P+1
.same
    LDA RS_P : CMP #LO(title_page_end) : BNE page
    LDA RS_P+1 : CMP #HI(title_page_end) : BNE page
.find
    \ The highest bank with no ROM that holds what's written to it.
    LDX #15
.bank
    LDA romtypes,X : BNE next
    STX RS_TRY
    SEI
    LDA romshad : PHA
    STX romshad : STX romsel
    LDA &8000 : TAY
    EOR #&FF : STA &8000
    EOR &8000 : STA RS_RES          ; 0 if what was written stayed
    TYA : STA &8000                 ; (put it back)
    PLA : STA romshad : STA romsel
    CLI
    LDX RS_TRY
    LDA RS_RES : BEQ found
.next
    DEX : BPL bank
    LDX #0
.none
    LDA none_text,X : BEQ stop
    JSR &FFEE : INX : BNE none
.stop
    JMP stop
.found
    STX RS_BANK
    \ !BOOT, the *EXEC file, closed (*FX119), so the DFS has no file open
    \ when the game hands it back its workspace for a load (sector.6502).
    LDA #119 : JSR &FFF4
    LDX #LO(load_cmd) : LDY #HI(load_cmd) : JSR &FFF7
    LDX #LO(sector_cmd) : LDY #HI(sector_cmd) : JSR &FFF7
    \ Into the bank, and leave it paged in.
    SEI
    LDA RS_BANK : STA romshad : STA romsel
    LDX #HI(sector_end - &8000 + &FF)
    LDY #0
.copy
    LDA &3000,Y : STA &8000,Y
    INY : BNE copy
    INC copy+2 : INC copy+5
    DEX : BNE copy
    CLI
    \ PRESS SPACE, and wait for it, with the title theme playing.
    \ (By its length: VDU 31's column, 0, would end it if a 0 did.)
    LDX #0
.press
    LDA press_text,X : JSR &FFEE
    INX : CPX #press_text_end - press_text : BNE press
    JSR tmus.mu_init
    LDA #&0F : STA tmus.mu_free     ; (every channel: no other sounds here)
    LDA #tmus.MUS_TITLE : STA tmus.mu_req
    LDA #0 : STA RS_MUSIC : STA m_down
.space
    LDA #19 : JSR &FFF4             ; the next VSync
    JSR tmus.mu_frame
    \ M: the music off, or on again, once a press (and the game keeps it).
    LDA #&81 : LDX #&9A : LDY #&FF : JSR &FFF4    ; INKEY -102: M
    CPX m_down : BEQ m_done
    STX m_down
    TXA : BEQ m_done                ; (let go)
    LDA RS_MUSIC : EOR #1 : STA RS_MUSIC
    BEQ m_on
    LDA #0 : STA tmus.mu_free       ; off: it plays on, silently
    LDA #&0F : JSR tmus.mu_quiet
    JMP m_done
.m_on
    LDA #&0F : STA tmus.mu_free : STA tmus.mu_dirty   ; (each note again)
.m_done
    LDA #&81 : LDX #&9D : LDY #&FF : JSR &FFF4    ; INKEY -99: SPACE
    CPX #&FF : BNE space
    LDA #&0F : JSR tmus.mu_quiet
    LDX #LO(run_cmd) : LDY #HI(run_cmd) : JMP &FFF7
.none_text  EQUS 31, 0, 21, "REDSHIFT needs 16K of sideways RAM", 13, 10
            EQUS "(a Model B with a RAM board, or a", 13, 10
            EQUS "Master 128).", 13, 10, 0
.load_cmd   EQUS "LOAD RSDATA", 13
.sector_cmd EQUS "LOAD S", '0' + START_SECTOR, 13     ; (at its own address, SECTOR_LOAD)
.run_cmd    EQUS "RUN REDSHFT", 13
\ The prompt has a row of its own, over the loading message: a flash code
\ runs to the end of its row, so it would set flashing whatever it shared one with.
.press_text EQUS 31, 0, PRESS_ROW, 136, T_YEL, "        PRESS SPACE TO PLAY           "
.press_text_end
ASSERT press_text_end - press_text - 3 = 40     ; (the whole row, to its end)
.m_down     EQUB 0                  ; M was down last VSync (&FF), or not
}

\ The title theme: the game's music player (musicplay.6502), a copy of its
\ own, with chip.6502's sound_write, which is safe with the OS running.
.tmus
{
    mu_ptr = RS_MU
    INCLUDE "chip.6502"
    INCLUDE "musicplay.6502"
    INCLUDE "../build/data/title.6502"
}

\ Teletext: 129 red, 131 yellow, 132 blue, 134 cyan, 135 white, 136 flash,
\ 141 double height, 157 the colour as background, 156 black background.
T_RED = 129 : T_YEL = 131 : T_BLUE = 132 : T_CYAN = 134 : T_WHITE = 135
T_DBL = 141 : T_BG = 157
PRESS_ROW = 23                  ; LOADING, then PRESS SPACE TO PLAY
MACRO TT_TITLE
    EQUS T_DBL, T_RED, "    R  E  D", T_CYAN, "S  H  I  F  T"
ENDMACRO
.title_page
    EQUS 22, 7                              ; MODE 7
    EQUS 23, 1, 0, 0, 0, 0, 0, 0, 0, 0      ; no cursor
    \ The title, the story, the keys and the rules, a row apart, and the
    \ prompt on a row of its own (PRESS_ROW).
    EQUS 31, 0, 0 : TT_TITLE
    EQUS 31, 0, 1 : TT_TITLE
    EQUS 31, 0, 3, T_WHITE, "    KHARON-4, 2189. THE DEEP MINE"
    EQUS 31, 0, 4, T_WHITE, "    HAS DUG INTO THE PRISM, AND"
    EQUS 31, 0, 5, T_WHITE, "    REALITY HAS COME APART."
    EQUS 31, 0, 6, T_RED, "    THE RED BELONGS TO THE MACHINES."
    EQUS 31, 0, 7, T_CYAN, "    THE BLUE BELONGS TO THE SWARM."
    EQUS 31, 0, 8, T_WHITE, "    ONE TROOPER. ONE HARNESS."
    EQUS 31, 0, 9, T_WHITE, "    THE NIGHT SHIFT NEVER CAME UP."
    EQUS 31, 0, 10, T_YEL, "    YOURS STARTS NOW."
    EQUS 31, 0, 12, T_YEL, " Z X ", T_WHITE, "left, right   ", T_YEL, ":  ", T_WHITE, "jump"
    EQUS 31, 0, 13, T_YEL, " /   ", T_WHITE, "crouch        ", T_YEL, "RETURN ", T_WHITE, "fire"
    EQUS 31, 0, 14, T_YEL, " SPACE ", T_WHITE, "grenade     ", T_YEL, "SHIFT ", T_WHITE, "phase"
    EQUS 31, 0, 15, T_WHITE, " (or cursor keys) ", T_YEL, "P ", T_WHITE, "pause  ", T_YEL, "M ", T_WHITE, "music"
    EQUS 31, 0, 16, T_YEL, " ESCAPE ", T_WHITE, "give the room up, for a life"
    EQUS 31, 0, 18, T_CYAN, "Each shift costs a phase cell. The"
    EQUS 31, 0, 19, T_CYAN, "other phase is dotted: it can't touch"
    EQUS 31, 0, 20, T_CYAN, "you, and you can't touch it. Out of"
    EQUS 31, 0, 21, T_CYAN, "cells? Find more; a life lost gives 2."
    EQUS 31, 0, 22, T_YEL, "Crouch: duck fire, or roll a grenade."
    EQUS 31, 15, PRESS_ROW, T_WHITE, "LOADING"
    EQUS 31, 0, 24, T_BLUE, build_stamp
.title_page_end
