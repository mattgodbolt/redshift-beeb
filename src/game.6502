\ ***************************************************************************
\ The game: a new game, the frame loop, rooms and phase shifts.
\ ***************************************************************************

.game_start
{
    LDX #&FF : TXS
    JSR cls
    \ Nothing anywhere.
    LDX #NOBJ - 1
.clear
    LDA #&FF : STA obj_spr,X
    LDA #0 : STA obj_st,X
    DEX : BPL clear
    LDA #0 : STA phase : STA pl_dead : STA pl_safe : STA pl_air : STA fire_cool
    STA score : STA score+1 : STA score+2
    LDX #MAX_ROOMS - 1
.gone
    STA room_gone,X
    DEX : BPL gone
    ASSERT NROOMS <= MAX_ROOMS
    LDA #START_LIVES : STA lives
    LDA #START_CELLS : STA cells
    LDA #START_GRENADES : STA grenades
    LDA #START_X * 4 : STA obj_x + PL
    LDA #(START_Y + 1) * 8 - PL_H : STA obj_y + PL
    LDA #0 : STA obj_face + PL
    LDA #SPR_ASH_STAND : STA obj_spr + PL
    LDA #0 : STA cur_sector : STA cage_go
IF DEFINED(START_ROOM)
    \ (A test build, make ROOM=n: room n, at its start.)
    LDA #1 : STA at_start
    LDA #START_ROOM
ENDIF
    JSR change_room
    LDA vsyncs : STA last_vs
.loop
    \ A game frame every two VSyncs.
    LDA vsyncs : SEC : SBC last_vs : CMP #2 : BCC loop
    LDA vsyncs : STA last_vs
    INC frame
    JSR read_keys
    LDA keys_new : BPL not_paused   ; (KB_PAUSE is bit 7)
    JSR pause
.not_paused
    LDA keys_new : AND #KB_SHIFT : BEQ no_shift
    LDA pl_dead : BNE no_shift
    JSR try_shift
.no_shift
    JSR player_update
    JSR shots_update
    JSR grenade_throw
    JSR grenade_update
    JSR things_update
    JSR ebolts_update
    JSR render
    JSR sound_update
    LDA cage_go : BEQ loop
    JSR take_cage
    JMP loop
}

\ Into the cage: down to the next sector (the room's down exit), in at the
\ start the room there gives.
.take_cage
{
    LDA #0 : STA cage_go
    LDA room_exits + 3 : CMP #&FF : BEQ done
    JSR sound_take
    LDA #1 : STA at_start
    LDA room_exits + 3 : JMP change_room
.done
    RTS
}

\ Into room A, the player where they are (or, with at_start set, where the
\ room's start is): the room drawn while the screen is black, then shown.
\ A new sector shows its card first. The shots go.
.change_room
{
    PHA
    JSR sector_of
    CMP cur_sector : BEQ same_sector
    STA cur_sector
    JSR show_card
.same_sector
    PLA
    JSR enter_room
    LDA at_start : BEQ placed
    LDA #0 : STA at_start
    LDA room_sx : CMP #&FF : BEQ placed
    ASL A : ASL A : STA obj_x + PL
    LDA room_sy : CLC : ADC #1 : ASL A : ASL A : ASL A
    SEC : SBC #PL_H : STA obj_y + PL
    LDA #0 : STA obj_face + PL : STA pl_air
.placed
    JSR spawn_things
    JSR objs_forget
    LDA obj_x + PL : STA entry_x
    LDA obj_y + PL : STA entry_y
    LDA obj_face + PL : STA entry_face
    LDA phase : STA entry_phase
    RTS
}

.enter_room
{
    LDX #1 : STX blackout
    JSR load_room
    JSR set_timing
    JSR set_colours
    JSR set_tile_ptrs
    JSR draw_room_all
    JSR draw_status
    JSR wait_vsync
    LDA #0 : STA blackout
    LDA #8 : STA crtc_reg
    LDA #CRTC_SHOW : STA crtc_data
    RTS
}

\ SHIFT: into the other phase, at the cost of a cell, unless the player
\ would be inside something solid there.
.try_shift
{
    LDA cells : BEQ refused
    JSR flip
    LDA #0 : STA ta_dy : LDA #PL_H - 1 : STA ta_h
    LDA obj_x + PL : JSR box_at
    LDA #TF_SOLID : JSR test_area : BEQ shifted
    JSR flip
.refused
    JMP sound_buzz
.shifted
    DEC cells
    JSR show_counts
    JMP shift_show
.flip
    LDA phase : EOR #1 : STA phase
    JMP set_tile_ptrs
}

\ Into the other phase, whatever's there.
.phase_shift
    JSR try_shift.flip
\ The new phase shown: its colours, its tiles redrawn, everything on them
\ drawn again.
.shift_show
{
    JSR sound_shift
    JSR wait_vsync
    JSR set_colours
    JSR draw_room_phase
    \ The enemies' bolts belong to the phase they were fired in.
    LDX #EB0
.bolts
    LDA #&FF : STA obj_spr,X
    INX : CPX #EB0 + NEB : BNE bolts
    JMP objs_touch
}

\ Sector A's card: three lines in the middle of a black screen, for a
\ few seconds or until a key.
.show_card
{
    ZA_AUTO1 sc_row, sc_n
    PHA
    LDX #1 : STX blackout
    JSR cls
    \ No bands: logical 1 yellow, in either phase.
    LDA #0 : STA band_n
    LDX #3
.colours
    LDA card_colours,X : STA top_red,X : STA top_blue,X
    DEX : BPL colours
    JSR set_timing
    JSR set_colours
    PLA : SEC : SBC #1 : TAX
    LDA card_lo,X : STA text_ptr
    LDA card_hi,X : STA text_ptr+1
    LDA #10 : STA sc_row
    LDA #3 : STA sc_n
.line
    \ Centred: (32 - its length) / 2.
    LDY #0
.len
    LDA (text_ptr),Y : BEQ got_len
    INY : BNE len
.got_len
    TYA : EOR #&FF : SEC : ADC #32 : LSR A : TAX
    LDY sc_row : JSR print_at
    INC text_ptr : BNE nc           ; (past the 0)
    INC text_ptr+1
.nc
    LDA sc_row : CLC : ADC #2 : STA sc_row
    DEC sc_n : BNE line
    JSR wait_vsync
    LDA #0 : STA blackout
    LDA #8 : STA crtc_reg
    LDA #CRTC_SHOW : STA crtc_data
    \ Three seconds, or a key once all are up. (read_keys uses X and Y.)
    \ Keys already down (the title's SPACE) aren't new.
    JSR read_keys
    LDA #150 : STA sc_n
.wait
    JSR wait_vsync
    JSR read_keys
    LDA keys_new : BNE done
    DEC sc_n : BNE wait
.done
    RTS
.card_colours EQUB BLACK, YELLOW, WHITE, CYAN
}

\ P: everything stops until P again.
.pause
{
.wait
    JSR wait_vsync
    JSR read_keys
    LDA keys_new : BPL wait
    LDA vsyncs : STA last_vs
    RTS
}
ASSERT KB_PAUSE = &80

START_LIVES = 5
START_CELLS = 5
START_GRENADES = 5

\ The last life gone: GAME OVER in the status bar, then a new game when a
\ key is pressed (after a moment, so a held key doesn't skip it).
.game_over
{
    PRINT_AT 0, 1, over_text
    LDY #100
.wait
    JSR wait_vsync
    DEY : BNE wait
.key
    JSR read_keys
    LDA keys : BEQ key
    JMP game_start
.over_text EQUS "   OUT OF LIVES. OUT OF PHASE.  ", 0
}

