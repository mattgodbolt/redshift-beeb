\ ***************************************************************************
\ The game.
\ ***************************************************************************

.game_start
{
    LDX #&FF : TXS
    JSR cls
    LDA #0 : JSR enter_room
.loop
    JSR wait_vsync : JSR wait_vsync
    INC frame
    LDX #K_SHIFT : JSR key_down : BEQ released
    LDA shift_held : BNE loop
    INC shift_held
    JSR phase_shift
    JMP loop
.released
    STA shift_held                  ; (A = 0)
    JMP loop
.shift_held EQUB 0
}

\ Go into room A: drawn while the screen is black, then shown.
.enter_room
{
    LDX #1 : STX blackout
    JSR load_room
    JSR set_timing
    JSR set_colours
    JSR set_tile_ptrs
    JSR draw_room_all
    JSR draw_status
    JSR wait_vsync
    LDA #0 : STA blackout
    LDA #8 : STA crtc_reg
    LDA #CRTC_SHOW : STA crtc_data
    RTS
}

\ Into the other phase: the colours, then the phase's tiles redrawn.
.phase_shift
{
    LDA phase : EOR #1 : STA phase
    JSR wait_vsync
    JSR set_colours
    JSR set_tile_ptrs
    JMP draw_room_phase
}

.draw_status
{
    PRINT_AT 0, 0, score_text
    LDA room_name : STA text_ptr
    LDA room_name+1 : STA text_ptr+1
    LDX #0 : LDY #1 : JMP print_at
.score_text EQUS "SCORE 000000      REDSHIFT", 0
}
