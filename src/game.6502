\ ***************************************************************************
\ The game: a new game, the frame loop, rooms and phase shifts.
\ ***************************************************************************

.game_start
{
    LDX #&FF : TXS
    \ The starting sector's file, back from the disc if a game that ended
    \ in a later sector loaded that one's over them.
    LDA #START_SECTOR : CMP loaded_sector : BEQ loaded
    JSR sector_load
.loaded
    JSR cls
    \ Nothing anywhere.
    LDX #NOBJ - 1
.clear
    LDA #&FF : STA obj_spr,X
    LDA #0 : STA obj_st,X
    DEX : BPL clear
    LDA #0 : STA phase : STA pl_dead : STA pl_safe : STA pl_air : STA fire_cool : STA shift_flash
    STA score : STA score+1 : STA score+2
    JSR music_phase
    LDX #MAX_ROOMS - 1
.gone
    STA room_gone,X
    DEX : BPL gone
    LDA #START_LIVES : STA lives
    LDA #START_CELLS : STA cells
    LDA #START_GRENADES : STA grenades
    LDA #START_X * 4 : STA obj_x + PL
    LDA #(START_Y + 1) * 8 - PL_H : STA obj_y + PL
    LDA #0 : STA obj_face + PL
    LDA #SPR_ASH_STAND : STA obj_spr + PL
    LDA #0 : STA cur_sector : STA cage_go
IF DEFINED(START_ROOM)
    \ (A test build, make ROOM=n: rooms.txt's room n, at its start.)
    LDA #1 : STA at_start
    LDA #ROOM_NUMBER[START_ROOM]
ENDIF
    JSR change_room
    LDA vsyncs : STA last_vs
.loop
    \ A game frame every two VSyncs.
    LDA vsyncs : SEC : SBC last_vs : CMP #2 : BCC loop
    LDA vsyncs : STA last_vs
    INC frame
    JSR read_keys
    LDA keys_new : BPL not_paused   ; (KB_PAUSE is bit 7)
    JSR pause
.not_paused
    JSR music_key
    JSR restart_key
    LDA keys_new : AND #KB_SHIFT : BEQ no_shift
    LDA pl_dead : BNE no_shift
    JSR try_shift
.no_shift
    JSR player_update
    JSR shots_update
    JSR grenade_throw
    JSR grenade_update
    JSR things_update
    JSR ebolts_update
    \ (The beat after the things, which throw switches: one that stops it
    \ leaves it nothing to do, so a frame lists each part once at most.)
    JSR mach_update
    JSR render
    JSR sound_update
    LDA shift_flash : BEQ no_flash
    DEC shift_flash : BNE no_flash
    JSR set_colours                 ; (the bar's own ink again)
.no_flash
    LDA cage_go : BEQ loop
    JSR take_cage
    JMP loop
}

\ Into the cage: down to the room its down exit names, in at the start that
\ room gives. That's the next sector's (NEXT_SECTOR set), whose rooms come
\ from the disc once the ride's done (sector.6502).
.take_cage
{
    LDA #0 : STA cage_go
    LDA room_exits + 3 : CMP #&FF : JEQ done
    \ The ride: Ash steps in, and the cage judders as it takes the strain,
    \ while its figure plays.
    JSR sound_quiet
    LDA #MUS_CAGE : JSR music_play
    LDA #&FF : STA obj_spr + PL
    LDA obj_st + PL : ORA #OS_CHANGED : STA obj_st + PL
    LDX #TH0
.find
    LDA th_type,X : CMP #TH_EXIT : BNE not_cage
    LDA obj_spr,X : CMP #&FF : BNE found
.not_cage
    INX : CPX #TH0 + NTH : BNE find
    JSR music_wait                  ; (no cage to shake)
    JMP ridden
.found
    STX tc_x
    LDA obj_x,X : STA tc_x0
    LDA #0 : STA tc_row
.ride
    JSR wait_vsync : JSR wait_vsync
    LDX tc_x
    \ Where it stands, and a step in from it, by turns (in, so never off
    \ the screen).
    LDA frame : AND #1 : LDY tc_x0 : BEQ rightward
    EOR #&FF : CLC : ADC #1         ; (left of where it stands)
.rightward
    CLC : ADC tc_x0 : STA obj_x,X
    LDA obj_st,X : ORA #OS_CHANGED : STA obj_st,X
    INC frame
    JSR render
    \ Going down: the room above goes dark, a row a frame from the top.
    LDA tc_row : CMP #MAP_H : BCS dark
    JSR dark_row
    INC tc_row
.dark
    LDA mus.mu_req : BPL ride       ; (not started yet)
    LDA mus.mu_piece : BPL ride     ; (still playing)
.ridden
    LDA #1 : STA at_start
    LDA room_exits + 3 : BPL in_sector
    LDX room_sector : INX : TXA : JSR sector_load
    LDA room_exits + 3 : AND #&FF - NEXT_SECTOR
.in_sector
    JMP change_room
.done
    RTS
.tc_x EQUB 0
.tc_x0 EQUB 0
.tc_row EQUB 0
\ Row tc_row of the playfield cleared to black.
.dark_row
    LDA tc_row : ASL A : CLC : ADC #HI(play_screen) : STA tc_p+1
    LDA #0 : STA tc_p : TAY
.clear
    STA (tc_p),Y : INY : BNE clear
    INC tc_p+1
.clear2
    STA (tc_p),Y : INY : BNE clear2
    RTS
}
tc_p = text_ptr                     ; (fixed zero page: nothing prints in the ride)
ASSERT LO(play_screen) = 0 AND ROW_BYTES = 512

\ Into room A, the player where they are (or, with at_start set, where the
\ room's start is): the room drawn while the screen is black, then shown.
\ A new sector shows its card first. The shots go.
.change_room
{
    PHA
    JSR sector_of
    CMP cur_sector : BEQ same_sector
    STA cur_sector
    JSR show_card
.same_sector
    PLA
    JSR enter_room
    LDA at_start : BEQ placed
    LDA #0 : STA at_start
    LDA room_sx : CMP #&FF : BEQ placed
    ASL A : ASL A : STA obj_x + PL
    LDA room_sy : CLC : ADC #1 : ASL A : ASL A : ASL A
    SEC : SBC #PL_H : STA obj_y + PL
    LDA #0 : STA obj_face + PL : STA pl_air
.placed
    JSR spawn_things
    JSR objs_forget
    LDA obj_x + PL : STA entry_x
    LDA obj_y + PL : STA entry_y
    LDA obj_face + PL : STA entry_face
    LDA phase : STA entry_phase
    RTS
}

.enter_room
{
    LDX #1 : STX blackout
    JSR load_room
    JSR set_timing
    JSR set_colours
    JSR set_tile_ptrs
    JSR draw_room_all
    JSR draw_status
    JSR wait_vsync
    LDA #0 : STA blackout
    LDA #8 : STA crtc_reg
    LDA #CRTC_SHOW : STA crtc_data
    RTS
}

\ SHIFT: into the other phase, at the cost of a cell, unless the player
\ would be inside something solid there.
FLASH_FRAMES = 8                ; a refused shift's red, in frames
.try_shift
{
    LDA cells : BEQ refused
    JSR flip
    LDA #0 : STA ta_dy : LDA #PL_H - 1 : STA ta_h
    LDA obj_x + PL : JSR box_at
    LDA #TF_SOLID : JSR test_area : BNE refuse
    \ Nor onto an enemy that would be there in the new phase (decision 45).
    JSR pl_box
    LDX #TH0
.enemy
    LDA obj_spr,X : CMP #&FF : BEQ next_enemy
    LDA th_boom,X : BNE next_enemy
    LDA th_type,X : CMP #TH_ENEMIES : BCS next_enemy
    JSR th_in_phase : BNE next_enemy
    JSR th_box
    JSR boxes_overlap : BCS refuse
.next_enemy
    INX : CPX #TH0 + NTH : BNE enemy
    JMP shifted
.refuse
    JSR flip
.refused
    \ Refused: the buzz, and the status bar red a moment.
    LDA #FLASH_FRAMES : STA shift_flash
    JSR set_colours
    JMP sound_buzz
.shifted
    DEC cells
    JSR show_counts
    JMP shift_show
.flip
    LDA phase : EOR #1 : STA phase
    JMP set_tile_ptrs
}

\ Into the other phase, whatever's there.
.phase_shift
    JSR try_shift.flip
\ The new phase shown: its colours, its tiles redrawn, everything on them
\ drawn again.
.shift_show
{
    JSR sound_shift
    JSR music_phase
    JSR wait_vsync
    JSR set_colours
    JSR draw_room_phase
    JSR show_phase
    \ The enemies' bolts belong to the phase they were fired in.
    LDX #EB0
.bolts
    LDA #&FF : STA obj_spr,X
    INX : CPX #EB0 + NEB : BNE bolts
    JMP objs_touch
}

\ Sector A's card: three lines in the middle of a black screen, for a
\ few seconds or until a key, and the sector's sting, which runs on into
\ the music under play. The card doesn't step the game's sounds, so they
\ stop: one left playing (the cage's) would keep its channel from the sting.
.show_card
{
    ZA_AUTO1 sc_row, sc_n
    PHA
    JSR sound_quiet
    PLA : PHA                       ; (the sector again: sound_quiet keeps only X and Y)
    CLC : ADC #MUS_CARD1 - 1 : JSR music_play
    JSR card_begin
    PLA : SEC : SBC #1 : TAX
    LDA card_lo,X : STA text_ptr
    LDA card_hi,X : STA text_ptr+1
    \ The sector's name in white (logical 2), its lines in yellow (1).
    LDA #1 : STA pr_ink
    LDA #10 : STA sc_row
    LDA #3 : STA sc_n
.line
    LDY sc_row : JSR print_centred
    LDA #0 : STA pr_ink
    LDA sc_row : CLC : ADC #2 : STA sc_row
    DEC sc_n : BNE line
    JSR card_frame                  ; (over the text: a long line reaches it)
    JSR card_show
    \ Three seconds, or a key once all are up. (read_keys uses X and Y.)
    \ Keys already down (the title's SPACE) aren't new.
    JSR read_keys
    LDA #150 : STA sc_n
.wait
    JSR wait_vsync
    JSR read_keys
    LDA keys_new : BNE done
    DEC sc_n : BNE wait
.done
    RTS
}

\ A card's screen (a sector's, or a disc error's: sector.6502), cleared
\ while it's black: no bands, logical 1 yellow, in either phase. Then
\ card_show shows it.
.card_begin
{
    LDX #1 : STX blackout
    JSR cls
    LDA #0 : STA band_n
    LDX #3
.colours
    LDA card_colours,X : STA top_red,X : STA top_blue,X
    DEX : BPL colours
    JSR set_timing
    JMP set_colours
.card_colours EQUB BLACK, YELLOW, WHITE, CYAN
}
.card_show
    JSR wait_vsync
    LDA #0 : STA blackout
    LDA #8 : STA crtc_reg
    LDA #CRTC_SHOW : STA crtc_data
    RTS

\ The line at text_ptr centred on row Y ((32 - its length) / 2, so 32 at
\ most), and text_ptr past its 0.
.print_centred
{
    ZA_AUTO1 pc_row
    STY pc_row
    LDY #0
.len
    LDA (text_ptr),Y : BEQ got_len
    INY : BNE len
.got_len
    TYA : EOR #&FF : SEC : ADC #32 : LSR A : TAX
    LDY pc_row : JSR print_at
    INC text_ptr : BNE done         ; (past the 0)
    INC text_ptr+1
.done
    RTS
}

\ P: everything stops until P again, and is silent.
.pause
{
    JSR sound_quiet
    JSR music_hold
.wait
    JSR wait_vsync
    JSR read_keys
    LDA keys_new : BPL wait
    JSR music_release
    LDA vsyncs : STA last_vs
    RTS
}
ASSERT KB_PAUSE = &80

START_LIVES = 5
START_CELLS = 5
START_GRENADES = 5

\ The last life gone: GAME OVER in the status bar, and its music, heard
\ to the end; then a new game when a key is pressed (pressed then: a key
\ still held from play doesn't skip it).
.game_over
{
    JSR sound_quiet
    LDA #MUS_OVER : JSR music_play
    PRINT_AT 0, 1, over_text
    JSR music_wait                  ; (the phrase heard out)
    JSR read_keys                   ; (keys held now aren't new)
.key
    JSR wait_vsync
    JSR read_keys
    LDA keys_new : BEQ key
    JMP game_start
.over_text EQUS "   OUT OF LIVES. OUT OF PHASE.  ", 0
}

\ ESCAPE: Ash gives the room up, for a life, and starts it again: a way out
\ of any corner, a phase gate with no cells among them (decision 40).
.restart_key
{
    LDX #K_ESCAPE : JSR key_down : BEQ up
    LDA rk_down : BNE done
    INC rk_down
    LDA pl_dead : BNE done
    JMP player_die
.done
    RTS
.up
    STA rk_down                     ; (A = 0)
    RTS
.rk_down EQUB 0
}

\ A sector card's frame, in logical 3 (cyan on the card): a box round
\ character rows FRAME_TOP to FRAME_BOT, columns FRAME_L to FRAME_R.
FRAME_TOP = 9 : FRAME_BOT = 15 : FRAME_L = 1 : FRAME_R = 30
.card_frame
{
    ZA_AUTO2 cf_p, cf_q
    ZA_AUTO1 cf_n
    \ The top's first line and the bottom's last.
    LDA #LO(screen + FRAME_TOP * ROW_BYTES + FRAME_L * 16) : STA cf_p
    LDA #HI(screen + FRAME_TOP * ROW_BYTES + FRAME_L * 16) : STA cf_p+1
    LDY #0 : JSR across
    LDA #LO(screen + FRAME_BOT * ROW_BYTES + FRAME_L * 16) : STA cf_p
    LDA #HI(screen + FRAME_BOT * ROW_BYTES + FRAME_L * 16) : STA cf_p+1
    LDY #7 : JSR across
    \ The sides: the left column's leftmost pixel, the right's rightmost.
    LDA #FRAME_BOT - FRAME_TOP + 1 : STA cf_n
    LDA #LO(screen + FRAME_TOP * ROW_BYTES + FRAME_L * 16) : STA cf_p
    LDA #HI(screen + FRAME_TOP * ROW_BYTES + FRAME_L * 16) : STA cf_p+1
    LDA #LO(screen + FRAME_TOP * ROW_BYTES + FRAME_R * 16 + 8) : STA cf_q
    LDA #HI(screen + FRAME_TOP * ROW_BYTES + FRAME_R * 16 + 8) : STA cf_q+1
.side_row
    LDY #7
.side_line
    LDA (cf_p),Y : ORA #&88 : STA (cf_p),Y          ; (pixel 0, logical 3)
    LDA (cf_q),Y : ORA #&11 : STA (cf_q),Y          ; (pixel 3, logical 3)
    DEY : BPL side_line
    INC cf_p+1 : INC cf_p+1         ; (the next row: ROW_BYTES on)
    INC cf_q+1 : INC cf_q+1
    DEC cf_n : BNE side_row
    RTS
\ Line Y across the columns, from cf_p.
.across
    LDX #FRAME_R - FRAME_L + 1
.col
    LDA #&FF : STA (cf_p),Y
    TYA : ORA #8 : TAY : LDA #&FF : STA (cf_p),Y : TYA : AND #7 : TAY
    LDA cf_p : CLC : ADC #16 : STA cf_p
    BCC same
    INC cf_p+1
.same
    DEX : BNE col
    RTS
}
ASSERT ROW_BYTES = 2 * 256

