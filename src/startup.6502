\ ***************************************************************************
\ Start-up: run once, from the loader, after the code has been copied down.
\ It stays where the file loaded, which the game's cls clears, so nothing
\ here may be called again: it ends by jumping into the game.
\ ***************************************************************************

.start
{
    ZA_ENTRY
    JSR grab_font               ; (while the OS is still ours to call)
    SEI                         ; interrupts stay off until install_irq
    \ The OS's interrupts as they are, for a sector's load to give back
    \ (sector.6502).
    LDA irq1v : STA os_irq1v
    LDA irq1v+1 : STA os_irq1v+1
    LDA sysvia_ier : STA os_sysier
    LDA usrvia_ier : STA os_usrier
    \ The data's bank (RSLOAD's), paged in for good.
    LDA RS_BANK : STA romshad : STA romsel
    LDA #ULA_MODE1 : STA ula_ctrl
    LDX #crtc_end - crtc_regs - 2
.crtc
    LDA crtc_regs,X : STA crtc_reg
    LDA crtc_regs+1,X : STA crtc_data
    DEX : DEX : BPL crtc
    LDA #1 : STA blackout       ; until the first room is drawn
    LDA #0 : STA vsyncs : STA irq_split : STA phase
    JSR install_irq
    \ Silence: each channel's volume off.
    LDA #&9F : JSR sound_write
    LDA #&BF : JSR sound_write
    LDA #&DF : JSR sound_write
    LDA #&FF : JSR sound_write
    LDA #0
    LDX #2
.voices
    STA snd_hi,X : STA snd_pri,X
    DEX : BPL voices
    LDA #&FF : STA snd_noise
    JSR music_init
    JMP game_start
}

\ Register, value pairs: MODE 1's, but R2 and R7 move with the narrower,
\ shorter picture to keep its centre where MODE 1's is (chuckie-egg-2-beeb's).
.crtc_regs
    EQUB 0, 127
    EQUB 3, &28
    EQUB 4, 38
    EQUB 5, 0
    EQUB 9, 7
    EQUB 10, &20                ; the cursor off
    EQUB 11, 8
    EQUB 1, SCREEN_COLS * 2
    EQUB 2, 98 - (80 - SCREEN_COLS * 2) / 2
    EQUB 6, SCREEN_ROWS
    EQUB 7, 34 - (32 - SCREEN_ROWS) / 2
    EQUB 12, HI(screen / 8)
    EQUB 13, LO(screen / 8)
    \ Blank for now (display enable off), and no interlace: with it, VSync
    \ moves half a line in alternate fields, and a palette split has to
    \ land in a 32us blank.
    EQUB 8, CRTC_BLANK
.crtc_end

\ The OS's font, characters 95 down to 32, read through OSWORD 10 (on a
\ Master the font isn't at &C000). Each call's block starts a byte early,
\ on the last row of the character below, which is read after.
.grab_font
{
    LDA #95 : STA gf_char
.char
    LDA gf_char : SEC : SBC #32
    LDX #0 : STX gf_ptr+1
    ASL A : ROL gf_ptr+1 : ASL A : ROL gf_ptr+1 : ASL A : ROL gf_ptr+1
    ADC #LO(font - 1) : STA gf_ptr
    LDA gf_ptr+1 : ADC #HI(font - 1) : STA gf_ptr+1
    LDY #0 : LDA gf_char : STA (gf_ptr),Y
    LDA #10 : LDX gf_ptr : LDY gf_ptr+1 : JSR osword
    DEC gf_char : LDA gf_char : CMP #31 : BNE char
    \ The status bar's icons, over characters it never prints.
    LDX #8 * 3 - 1
.icon
    LDA icons,X : STA font + 8 * (ICON_CELL - 32),X
    DEX : BPL icon
    RTS
\ A PHASE CELL (spar in its sleeve), a FRACTURE CHARGE, a TRAUMA KIT.
.icons
    EQUB &18, &3C, &7E, &66, &7E, &66, &7E, &00
    EQUB &08, &10, &38, &7C, &6C, &7C, &38, &00
    EQUB &38, &28, &FE, &82, &BA, &82, &FE, &00
ASSERT ICON_GREN = ICON_CELL + 1 AND ICON_LIFE = ICON_CELL + 2
}
gf_char = rd_ptr                ; (fixed zero page nobody's using yet)
gf_ptr = text_ptr
