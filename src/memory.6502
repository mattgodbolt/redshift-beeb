\ ***************************************************************************
\ REDSHIFT - where things live, outside the code.
\
\ Zero page &00-ZP_FIXED-1 is baron's allocator pool (ZA_AUTO); ZP_FIXED up
\ to &8F holds what lives for the whole game, or that the interrupt shares.
\ The OS keeps &90 up: its IRQ entry saves A at &FC, which irq_handler
\ reads back.
\
\ Once the game has the interrupts and reads the keyboard itself, the OS's
\ pages 4-12 are free (porting-to-the-beeb.md, "Memory"): the 100Hz
\ interrupt that rewrites page 8 is stopped, and nothing else touches them.
\ Page 13 (the NMI and a Master's extended vectors) is left alone. Nothing
\ in these sections is in the file: start-up and the room set them up.
\ ***************************************************************************

ZP_FIXED = &60

SECTION ZeroPage, org = ZP_FIXED, guard = &90, virtual = TRUE
\ Shared with the interrupt.
.vsyncs     SKIP 1          ; VSyncs since start-up (irq.6502)
.irq_split  SKIP 1          ; T1 interrupts since this VSync
.blackout   SKIP 1          ; non-zero: every palette entry black (room changes)
\ The game's state.
.phase      SKIP 1          ; 0: the Red Phase, 1: the Blue
.room       SKIP 1          ; the room we're in
.room_ptr   SKIP 2          ; its record (rooms.6502)
.tp_lo      SKIP 2          ; this phase's tile pointers: low bytes (gfx.6502)
.tp_hi      SKIP 2          ; ... and high bytes
.attr_ptr   SKIP 2          ; what each tile is in this phase (gfx.6502's attr_*)
.frame      SKIP 1          ; game frames (25 a second)
.rng        SKIP 2
.text_ptr   SKIP 2          ; print_at's text (screen.6502)
.keys       SKIP 1          ; the keys down (player.6502's KB_*)
.keys_new   SKIP 1          ; ... and gone down since the last frame
.ta_c0      SKIP 1          ; test_area's rectangle, in tiles (player.6502)
.ta_c1      SKIP 1
.ta_r0      SKIP 1
.ta_r1      SKIP 1
.ta_mask    SKIP 1
.ta_dy      SKIP 1          ; box_at's lines below the sprite's top
.ta_h       SKIP 1          ; ... and the box's height less one
.last_vs    SKIP 1          ; vsyncs at the last game frame
.rd_ptr     SKIP 2          ; the room reader's place (rooms.6502)
ENDSECTION

SECTION LowPages, org = &0400, guard = &0D00, virtual = TRUE
\ The room's map: a tile number per cell, MAP_W to a row.
.map        SKIP MAP_W * MAP_H

\ The palette program the interrupt plays (irq.6502, bands.6502). In one
\ page, so no indexed read takes the extra cycle that would move a split.
    ALIGN 256
.irq_tables
.status_ula SKIP 6          ; the status bar's six entries (logical 0 and 1)
.room_ula   SKIP 16         ; the playfield's top: ten entries, then the six
MAXEV = 8                   ; palette changes in a room, below its top
.ev_u0      SKIP MAXEV      ; each change's four &FE21 writes
.ev_u1      SKIP MAXEV
.ev_u2      SKIP MAXEV
.ev_u3      SKIP MAXEV
.lat_first  SKIP 2          ; T1's latch from VSync: the status split to change 0
.lat_lo     SKIP MAXEV + 1  ; ... and the latch each split sets: fire j sets
.lat_hi     SKIP MAXEV + 1  ; the period from fire j + 1 to fire j + 2
.irq_tables_end
    ASSERT HI(irq_tables) = HI(irq_tables_end - 1)

\ The room's bands as the room gives them (bands.6502): the line, the
\ logical colour, the Red Phase's colour and the Blue's.
.band_n     SKIP 1
.band_line  SKIP MAXEV
.band_log   SKIP MAXEV
.band_red   SKIP MAXEV
.band_blue  SKIP MAXEV
.top_red    SKIP 4          ; logical 0-3 at the top of the playfield
.top_blue   SKIP 4
.room_exits SKIP 4          ; left, right, up, down: room numbers, &FF none
.room_name  SKIP 2          ; the room's name (in its record)
.things_ptr SKIP 2          ; its things (in its record)

\ The things on screen (render.6502): the player, shots, enemies,
\ explosions. Drawn in slot order, so later slots are on top.
NOBJ = 12
.obj_spr    SKIP NOBJ       ; sprite number (SPR_*), or &FF: none
.obj_x      SKIP NOBJ       ; in 2-pixel steps from the left (0-127)
.obj_y      SKIP NOBJ       ; the playfield line of its top
.obj_face   SKIP NOBJ       ; 0 facing right, 2 facing left (the sprite's version)
.obj_st     SKIP NOBJ       ; OS_CHANGED, OS_SHOWN
OS_CHANGED = 1              ; moved or changed since it was drawn
OS_SHOWN = &80              ; on the screen, at o_*
\ Rectangles in byte columns (0-64) and character rows (0-22) of the
\ playfield, each end exclusive: where it was drawn, where it is now,
\ and what has to be drawn for it (render.6502's footprint).
.o_c0 SKIP NOBJ : .o_c1 SKIP NOBJ : .o_r0 SKIP NOBJ : .o_r1 SKIP NOBJ
.n_c0 SKIP NOBJ : .n_c1 SKIP NOBJ : .n_r0 SKIP NOBJ : .n_r1 SKIP NOBJ
.f_c0 SKIP NOBJ : .f_c1 SKIP NOBJ : .f_r0 SKIP NOBJ : .f_r1 SKIP NOBJ
.shot_dx    SKIP NOBJ       ; a shot's steps a frame (player.6502)
.obj_pend   SKIP NOBJ       ; still to be drawn this frame
.obj_in     SKIP NOBJ       ; in the rectangle being drawn
\ The player (player.6502).
.pl_dead    SKIP 1          ; frames left of dying, or 0
.pl_air     SKIP 1          ; 0 on the ground, 1 rising, 2 falling
.pl_ji      SKIP 1          ; how far into the jump
.pl_fall    SKIP 1          ; lines a frame, falling
.pl_steps   SKIP 1
.pl_crouch  SKIP 1
.pl_moved   SKIP 1
.pl_anim    SKIP 1
.pl_ox      SKIP 1          ; how it was at the frame's start
.pl_oy      SKIP 1
.pl_ospr    SKIP 1
.pl_oface   SKIP 1
.fire_cool  SKIP 1
.entry_x    SKIP 1          ; how the player came into the room
.entry_y    SKIP 1
.entry_face SKIP 1
.entry_phase SKIP 1
\ Each row of the rectangle being drawn: where it starts in the target.
.trow_lo    SKIP MAP_H
.trow_hi    SKIP MAP_H

\ The compose buffer (render.6502): a rectangle of the screen is put
\ together here, then copied out, so each screen byte is written once.
    ALIGN 256
.cbuf       SKIP 1024
CBUF_SIZE = 1024
.low_end
ENDSECTION
