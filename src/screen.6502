\ ***************************************************************************
\ The screen: clearing it, drawing the room's tiles, and text.
\
\ The playfield's tiles are in screen order: a tile is two character cells
\ (16 bytes, the left cell's 8 lines then the right's), 32 make a 512-byte
\ character row, and the rows follow on. So tile n of the map is at
\ play_screen + 16n, and the room draws in one straight run.
\ ***************************************************************************

\ Clear the whole screen.
.cls
{
    LDA #HI(screen) : STA cl_dst+2
    LDA #0
    LDX #0
.page
    LDY #0
.loop
.cl_dst
    STA screen,Y
    INY : BNE loop
    INC cl_dst+2
    LDX cl_dst+2 : BPL page         ; (up to &7FFF)
    RTS
}

\ Point tp_lo and tp_hi at this phase's tile pointers (gfx.6502).
.set_tile_ptrs
{
    LDA phase : BNE blue
    LDA #LO(tiles_red) : LDX #HI(tiles_red)
    BNE set                         ; (always)
.blue
    LDA #LO(tiles_blue) : LDX #HI(tiles_blue)
.set
    STA tp_lo : STX tp_lo+1
    CLC : ADC #NTILES : STA tp_hi
    TXA : ADC #0 : STA tp_hi+1
    \ ... and at what each tile is in this phase (attr_red, attr_blue).
    LDA phase : BNE blue_attr
    LDA #LO(attr_red) : STA attr_ptr
    LDA #HI(attr_red) : STA attr_ptr+1
    RTS
.blue_attr
    LDA #LO(attr_blue) : STA attr_ptr
    LDA #HI(attr_blue) : STA attr_ptr+1
    RTS
}

\ Draw the whole room from the map, in this phase. With mask_flags set,
\ only the tiles with one of those flags (tile_attr): a phase shift redraws
\ just the red and blue tiles.
.draw_room_all
    LDA #&FF : BNE draw_room_flags  ; (always)
.draw_room_phase
    LDA #TF_RED OR TF_BLUE
.draw_room_flags
{
    ZA_AUTO2 dr_src, dr_dst, dr_map
    ZA_AUTO1 dr_mask
    STA dr_mask
    LDA #LO(map) : STA dr_map
    LDA #HI(map) : STA dr_map+1
    LDA #LO(play_screen) : STA dr_dst
    LDA #HI(play_screen) : STA dr_dst+1
.tile
    LDY #0 : LDA (dr_map),Y : TAY
    LDA tile_attr,Y : ORA #&80 : AND dr_mask : BEQ next  ; (&FF: every tile)
    TYA : BNE look
    LDA dr_map : SEC : SBC #LO(map) : JSR back_look : TAY
.look
    LDA (tp_lo),Y : STA dr_src
    LDA (tp_hi),Y : STA dr_src+1
    LDY #15
.copy
    LDA (dr_src),Y : STA (dr_dst),Y
    DEY : BPL copy
.next
    LDA dr_dst : CLC : ADC #16 : STA dr_dst
    BCC no_carry
    INC dr_dst+1
.no_carry
    INC dr_map : BNE same
    INC dr_map+1
.same
    LDA dr_map : CMP #LO(map + MAP_W * MAP_H) : BNE tile
    LDA dr_map+1 : CMP #HI(map + MAP_W * MAP_H) : BNE tile
    RTS
}

\ Air is drawn as the back wall: the look for where it falls on the wall's
\ two by two grid. A = the cell's place in the map (row * 32 + column, its
\ low byte: bit 5 is the row's parity, bit 0 the column's). X and Y kept.
.back_look
    AND #&21 : CMP #&20 : BCC got
    SBC #&20 - 2                    ; (&20, &21: the bottom row, 2 and 3)
.got
    CLC : ADC #T_EMPTY_TL
    RTS
ASSERT T_EMPTY_TR = T_EMPTY_TL + 1 AND T_EMPTY_BL = T_EMPTY_TL + 2 AND T_EMPTY_BR = T_EMPTY_TL + 3
ASSERT T_EMPTY = 0

\ Draw the map's tile at column X, row Y of the playfield.
.draw_tile_xy
{
    ZA_AUTO2 dt_src, dt_dst
    ZA_AUTO1 dt_row
    STY dt_row
    TXA : ASL A : ASL A : ASL A : ASL A : STA dt_dst   ; 16 a tile
    TXA : LSR A : LSR A : LSR A : LSR A : STA dt_dst+1
    TYA : ASL A : ADC dt_dst+1 : ADC #HI(play_screen) : STA dt_dst+1
    LDA maprow_lo,Y : STA dt_src
    LDA maprow_hi,Y : STA dt_src+1
    TXA : TAY
    LDA (dt_src),Y : TAY : BNE look
    LDA dt_row : ASL A : ASL A : ASL A : ASL A : ASL A
    STX dt_src : ORA dt_src : JSR back_look : TAY
.look
    LDA (tp_lo),Y : STA dt_src
    LDA (tp_hi),Y : STA dt_src+1
    LDY #15
.copy
    LDA (dt_src),Y : STA (dt_dst),Y
    DEY : BPL copy
    RTS
}

\ Text in the status bar, in logical colour 1 on 0. The font is the OS's,
\ read at start-up (startup.6502's grab_font), characters 32-95, with the
\ bar's icons over three of them. On the bar's second row the bottom line
\ of each character is the bar's rule.
\ print_at: X = column (0-31), Y = row (0-1), then the text's address in
\ pr_text; it ends at a 0. Characters 96-127 are shown as 64-95 (capitals).
.print_at
{
    ZA_AUTO2 pr_dst, pr_glyph
    JSR locate
.char
    LDY #0 : LDA (pr_text),Y : BEQ done   ; (print_char_a leaves Y at &FF)
    INC pr_text : BNE got
    INC pr_text+1
.got
    JSR print_char_a
    JMP char
.done
    RTS
\ A nibble of a glyph's pixels (logical colour 1's bits) in the ink: 0 for
\ logical 1, 1 for 2, 2 for 3.
.inked
    LDX pr_ink : BEQ ink_done
    STA pr_nib
    ASL A : ASL A : ASL A : ASL A
    CPX #1 : BEQ ink_done
    ORA pr_nib
.ink_done
    RTS
.pr_nib EQUB 0
\ pr_dst = column X, row Y of the status bar.
.locate
    TXA : ASL A : ASL A : ASL A : ASL A : STA pr_dst    ; 16 a column
    TXA : LSR A : LSR A : LSR A : LSR A : STA pr_dst+1
    TYA : ASL A : ADC pr_dst+1 : ADC #HI(screen) : STA pr_dst+1
    RTS
\ Character A at column X, row Y.
.print_char_at
    PHA : JSR locate : PLA
\ A character at pr_dst, which moves on a column.
.print_char_a
    AND #&7F : CMP #96 : BCC upper
    SBC #32
.upper
    SEC : SBC #32                   ; (no character below 32 is printed)
    \ The glyph: font + 8 * (char - 32).
    LDX #0 : STX pr_glyph+1
    ASL A : ROL pr_glyph+1
    ASL A : ROL pr_glyph+1
    ASL A : ROL pr_glyph+1
    ADC #LO(font) : STA pr_glyph
    LDA pr_glyph+1 : ADC #HI(font) : STA pr_glyph+1
    \ Each row's left four pixels in the left cell, the right four in the
    \ right cell, in the ink (pr_ink: logical colour 1, 2 or 3).
    LDY #7
.row
    LDA (pr_glyph),Y : LSR A : LSR A : LSR A : LSR A : JSR inked : STA (pr_dst),Y
    LDA (pr_glyph),Y : AND #15 : JSR inked
    PHA : TYA : ORA #8 : TAY : PLA
    STA (pr_dst),Y
    TYA : AND #7 : TAY
    DEY : BPL row
    \ On the bar's second row, its bottom line is the rule.
    LDA pr_dst+1 : CMP #HI(screen + ROW_BYTES) : BCC no_rule
    CMP #HI(screen + 2 * ROW_BYTES) : BCS no_rule      ; (a card's text isn't ruled)
    LDA #&0F                        ; (logical 1 across: a solid line)
    LDY #7 : STA (pr_dst),Y
    LDY #15 : STA (pr_dst),Y
.no_rule
    LDA pr_dst : CLC : ADC #16 : STA pr_dst
    BCC same
    INC pr_dst+1
.same
    RTS
}
\ (In fixed zero page: callers set it.)
pr_text = text_ptr

\ PRINT_AT col, row, text: the string's in line, after the call.
MACRO PRINT_AT col, row, text
    LDA #LO(text) : STA text_ptr
    LDA #HI(text) : STA text_ptr+1
    LDX #col : LDY #row : JSR print_at
ENDMACRO
