\ ***************************************************************************
\ REDSHIFT for the BBC Micro - build file
\
\ !BOOT runs RSLOAD (rsload.6502), which puts RSDATA, the shared art and
\ the text, and S1, the first sector's rooms and looks, in a sideways RAM
\ bank (decisions 12, 42 and 43) and runs REDSHFT: it loads at &1900,
\ copies the game down to &0E00 (over the DFS's workspace: sector.6502
\ puts it back for a load) and starts it. The cage loads each sector's
\ file after.
\ ***************************************************************************

INCLUDE "defs.6502"
\ What the rooms are: the sectors, their sizes, where a new game starts.
INCLUDE "../build/data/rooms.6502"
INCLUDE "memory.6502"

\ The build stamp comes from the Makefile (-D BUILD="date sha"), so a disc
\ says what it is: *TYPE !BOOT shows it. A + after the sha means the tree
\ had uncommitted changes.
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

\ The sector a game starts in, whose rooms RSLOAD loads at boot: the first
\ room's, or in a test build (make ROOM=n) the start room's.
IF DEFINED(START_ROOM)
    START_SECTOR = ROOM_SECTOR[START_ROOM]
ELSE
    START_SECTOR = FIRST_SECTOR
ENDIF
\ (A sector's file is S and its digit: sector.6502 and RSLOAD write it.)
ASSERT SECTORS <= 9

SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| REDSHIFT ", build_stamp, 13
    EQUS "*RUN RSLOAD", 13
ENDSECTION

\ The shared art and the text, read where they are in the sideways bank.
SECTION Data, org = &8000, load = &FFFF3000, filename = "RSDATA", guard = &C000
    INCLUDE "../build/data/gfx.6502"
    INCLUDE "text.6502"
.data_end
ENDSECTION

\ Then the sector region: one sector's file at a time, read in place, sized
\ for the largest (decisions 42 and 43). Each sector's file (S1, S2...) is
\ assembled here. The first's loads at boot just after RSDATA, so RSLOAD
\ copies both into the bank at once; the cage loads the next one's into
\ screen memory and copies it in (sector.6502).
SECTOR_AT   = data_end
sector_end  = SECTOR_AT + SECTOR_SIZE
SECTOR_LOAD = &3000 + (SECTOR_AT - &8000)
\ Copies into the bank go by whole pages, so past the region's end, into
\ the bank's free space: nothing follows the region.
SECTOR_PAGES = HI(SECTOR_SIZE + &FF)
ASSERT SECTOR_AT + SECTOR_PAGES * &100 <= &C000, "the sector region's copies run past the bank"
\ What every sector's file has in the same place (sector<n>.6502): each
\ room's record, by its number in the sector; then the tables for every
\ look, NTILES long, the shared looks' and the sector's own (looks<n>.6502
\ and tools/mkgfx.py say what's in them). So a sector's load brings its
\ looks with its rooms, and the game reads both where they are.
room_lo    = SECTOR_AT
room_hi    = room_lo + SECTOR_ROOMS
tiles_red  = room_hi + SECTOR_ROOMS
tiles_blue = tiles_red + 2 * NTILES
tile_attr  = tiles_blue + 2 * NTILES
attr_red   = tile_attr + NTILES
attr_blue  = attr_red + NTILES
ASSERT SECTOR_ROOMS <= MAX_ROOMS
ASSERT NTILES <= 128                ; (the rooms' packing has 7 bits a look)
PRINT "data &8000-&", ~data_end, ", sector &", ~SECTOR_AT, "-&", ~sector_end, " (", &C000 - sector_end, " bytes free)"
PRINT "  looks: ", NSHARED, " shared, so a sector can have ", 128 - NSHARED, " of its own"
FOR s = 1..SECTORS
    PRINT "  S", s, ": ", SECTOR_NROOMS[s - 1], " rooms, ", SECTOR_LOOKS[s - 1], " looks, ", SECTOR_BYTES[s - 1], " bytes"
NEXT
INCLUDE "../build/data/sectors.6502"

\ Below MODE 7's screen, above where RSDATA and S1 load (the ASSERT): they
\ would reach it only with the bank nearly full. Low enough for the title
\ theme and its player (decision 33).
RSLOAD_AT = &6C00
SECTION RsLoad, org = RSLOAD_AT, load = &FFFF0000 + RSLOAD_AT, exec = &FFFF0000 + RSLOAD_AT, filename = "RSLOAD", guard = &7C00
    INCLUDE "rsload.6502"
.rsload_end
    PRINT "rsload &", ~RSLOAD_AT, "-&", ~rsload_end, " (", &7C00 - rsload_end, " bytes free)"
ENDSECTION
\ (A DFS can write the whole of a file's last sector, so S1's load is
\ checked to the end of its last.)
ASSERT SECTOR_LOAD + SECTOR_PAGES * &100 <= RSLOAD_AT, "RSDATA and S1 load over RSLOAD"

SECTION Loader, org = &1900, load = &FFFF1900, exec = &FFFF0000 + loader, filename = "REDSHFT"
.payload
    SECTION Code, org = &0E00, guard = screen
    ZA_POOL &00..ZP_FIXED-1
.code_start
    INCLUDE "system.6502"
    INCLUDE "irq.6502"
    INCLUDE "sound.6502"
    INCLUDE "music.6502"
    INCLUDE "screen.6502"
    INCLUDE "bands.6502"
    INCLUDE "rooms.6502"
    INCLUDE "render.6502"
    INCLUDE "player.6502"
    INCLUDE "things.6502"
    INCLUDE "machines.6502"
    INCLUDE "status.6502"
    INCLUDE "game.6502"
    INCLUDE "sector.6502"
\ The OS's font, characters 32-95 (startup.6502's grab_font), with a byte
\ before it for OSWORD 10's block.
    SKIP 1
.font
    SKIP 64 * 8
.code_end
    PRINT "code &", ~code_start, "-&", ~code_end, " (", screen - code_end, " bytes free)"
    ENDSECTION

\ Runs from where the file loaded, after the payload; nothing in here is
\ needed afterwards.
.loader
{
    \ What the DFS keeps between calls, and the OS's page 8, as they are
    \ now, before the copy down writes over the one and the game takes the
    \ other: into the payload, so the copy takes them to dfs_keep and
    \ os_page8, for a sector's load (sector.6502).
    LDX #0
.keep
FOR p = 0..KEEP_PAGES - 1
    LDA DFS_KEEP + p * &100,X : STA dfs_keep - code_start + payload + p * &100,X
NEXT
    LDA OS_SOUND,X : STA os_page8 - code_start + payload,X
    INX : BNE keep
    LDX #HI(code_end - code_start + &FF)
    LDY #0
.copy_down
    LDA payload,Y : STA code_start,Y
    INY : BNE copy_down
    INC copy_down+2 : INC copy_down+5
    DEX : BNE copy_down
}
    INCLUDE "startup.6502"
.loader_end
    ASSERT loader_end <= &7C00      ; below MODE 7's screen, where it loads
ENDSECTION
